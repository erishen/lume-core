// Loops — while, C-style for, break/continue.
//
//   make && bin/lume-llvm --compile examples/loop.lume && out/loop

func is_prime(n: int): bool {
  if (n < 2) { return false; }
  let d = 2;
  while (d * d <= n) {
    if (n % d == 0) { return false; }
    d = d + 1;
  }
  return true;
}

func main(): int {
  let i = 1;
  while (i <= 20) {
    if (i % 15 == 0) { print("fizzbuzz"); }
    else if (i % 3 == 0) { print("fizz"); }
    else if (i % 5 == 0) { print("buzz"); }
    else { print(i); }
    i = i + 1;
  }

  let found = 0;
  for (let k = 0; k < 100; k = k + 1) {
    if (is_prime(k)) {
      print(k);
      found = found + 1;
      if (found == 4) { break; }
    }
  }
  print(0);
  return 0;
}
