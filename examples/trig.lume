// trig_check.lume — verify trig/hyperbolic/inverse-trig on both backends.
print(sin(0.0));
print(cos(0.0));
print(tan(0.0));
print(sin(3.141592653589793 / 2.0));
print(cos(3.141592653589793));
print(asin(1.0));
print(acos(1.0));
print(atan(1.0));
print(atan2(1.0, 1.0));
print(sinh(0.0));
print(cosh(0.0));
print(tanh(0.0));
print(asinh(1.0));
print(acosh(1.0));
print(atanh(0.5));
