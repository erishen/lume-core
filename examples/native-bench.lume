// Throughput target for the two native backends.
//
//   make native-bench      compile + run both, print sizes and timings
//   make native            same program through the text backend (fact)
//   make native-llvm       same program through the libLLVM backend (fact)
//
// Loops are the point: locals are alloca slots, so a backend that cannot
// promote them (no mem2reg) pays a memory round trip on every iteration.
//
// The workload is nested on purpose. The four outer locals make odd grow
// ~n^3, so a flat loop of 1e8 would overflow i64 long before the timing
// difference showed up; an inner loop of 1000 keeps the result bounded
// while multiplying the number of promoted-locals-away iterations.
//
//   odd = n(n+1)/2 - K*n(n+1)/2 = (1-K)*n(n+1)/2     with K = 1000

func work(n: int): int {
  let sum = 0;
  let acc = 0;
  let odd = 0;
  let i = 1;
  while (i <= n) {
    let s2 = 0;          // inner locals: more slots to promote away
    let j = 0;
    while (j < 1000) {
      s2 = s2 + i;
      j = j + 1;
    }
    sum = sum + s2;
    acc = acc + i;
    odd = acc - sum;
    i = i + 1;
  }
  return odd;
}

func main(): int {
  print(work(100));              // correctness anchor: odd = -999*100*101/2
  print(work(100000));           // 1e8 inner iterations total
  return 0;
}

// The native entry only runs the top level; main() has to be called from here.
main();
