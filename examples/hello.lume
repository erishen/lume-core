// Lume 最小脚本 —— 一个函数、print、一个返回值。
//
//   make && ./bin/lume examples/hello.lume
//   ./bin/lume --check examples/hello.lume        # 只解析 + 类型检查
//
// 注意:本树是纯语言本体,**没有 server {} 也没有 run()** ——
// 那两样只存在于宿主树 work/research/lume(它嵌了 agent-httpd)。
// 这里的脚本从上到下执行完就退出,不起服务器、不碰网络。

// 带返回类型的函数;返回值用 return。
func greet(name: string, times: int): string {
  let msg = "hello, " + name;
  // 循环 + 字符串拼接
  for (let i = 0; i < times; i = i + 1) {
    msg = msg + "!";
  }
  return msg;
}

// 顶层的 let 就是普通变量,类型由初值推断。
let who = "lume";
let n = 3;

print(greet(who, n));
print(str(2) + " + " + str(40) + " = " + str(42));

// map 字面量;读 map 一律用 get(m, "k", 缺省值)
// ——脚本里没有 r["k"] 这种下标写法。
let cfg = { name: "hello", retries: 3 };
print("cfg.name=" + str(get(cfg, "name", "")) +
      " cfg.retries=" + str(get(cfg, "retries", 0)) +
      " cfg.missing=" + str(get(cfg, "missing", "D")));
