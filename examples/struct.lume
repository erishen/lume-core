// Structs — `type Name = { f: T, ... }`, field access, struct-valued results.
//
//   make && bin/lume-llvm --compile examples/struct.lume && out/struct

type Rect = { w: int, h: int };

func scale(r: Rect, k: int): Rect {
  return { w: r.w * k, h: r.h * k };
}

func area(r: Rect): int {
  return r.w * r.h;
}

func main(): int {
  let a: Rect = { w: 3, h: 4 };
  let b = scale(a, 5);
  print(b.w);
  print(b.h);
  print(area(a));
  print(area(b));
  return 0;
}
