// sci_demo.lume — 信息与计算科学算法库演示 + 自校验
//   运行：bin/lume-core examples/sci_demo.lume
//         bin/lume-core --compile-text  -o t.exe examples/sci_demo.lume && t.exe
//         bin/lume-core --compile-llvm  -o l.exe examples/sci_demo.lume && l.exe
// 三后端输出应逐字节一致（同 AST，浮点运算顺序由 lume 显式控制）。

import "../lib/sci.lume" as sci;

print("SCI_VERSION = " + sci.SCI_VERSION);

// ---- 信息论 ----
let p = [0.5, 0.5];
print("entropy([0.5,0.5])        = " + str(sci.entropy(p)));            // 1.0
print("entropy(uniform 4)        = " + str(sci.entropy([0.25, 0.25, 0.25, 0.25]))); // 2.0

let q = [0.5, 0.5];
print("kl(p||q) same dist        = " + str(sci.kl_divergence(p, q)));   // ~0
let p2 = [0.9, 0.1];
let q2 = [0.5, 0.5];
print("kl(p2||q2)                = " + str(sci.kl_divergence(p2, q2))); // >0
print("cross_entropy(p2,q2)      = " + str(sci.cross_entropy(p2, q2)));
print("js(p2||q2) symmetric,bdd  = " + str(sci.js_divergence(p2, q2)));  // in [0,1]

// 互信息：X=Y 完全相关 → I = H(X)；X⊥Y 独立 → I = 0
let mi_corr = [[0.5, 0.0], [0.0, 0.5]];
print("MI(correlated X=Y)        = " + str(sci.mutual_information(mi_corr))); // = entropy = 1.0
let mi_indep = [[0.25, 0.25], [0.25, 0.25]];
print("MI(independent)           = " + str(sci.mutual_information(mi_indep))); // 0.0

// ---- 数值积分：∫_0^1 x^2 dx = 1/3 ----
let xs = [0.0, 0.25, 0.5, 0.75, 1.0];
let ys = map((x) => x * x, xs);
print("trapz(x^2,0..1)           = " + str(sci.trapz(xs, ys)));         // ≈0.3333
print("simpson(x^2,0..1)         = " + str(sci.simpson(xs, ys)));       // =1/3 exact

// ---- 插值：通过 (0,0)(1,1)(2,4) 即 y=x^2 ----
let ix = [0.0, 1.0, 2.0];
let iy = [0.0, 1.0, 4.0];
print("interp_linear(x^2, 1.5)    = " + str(sci.interp_linear(ix, iy, 1.5))); // 2.5
print("interp_lagrange(x^2,1.5)  = " + str(sci.interp_lagrange(ix, iy, 1.5))); // 2.25 exact

// ---- 多项式：x^2 - 2 （根 sqrt(2)≈1.41421356）----
let coeffs = [-2.0, 0.0, 1.0];   // -2 + 0*x + 1*x^2
print("poly_val(x^2-2, 1.4142)   = " + str(sci.poly_val(coeffs, 1.41421356)));
print("bisect_poly(x^2-2,1,2)    = " + str(sci.bisect_poly(coeffs, 1.0, 2.0, 1e-12)));
print("newton_poly(x^2-2, 1)     = " + str(sci.newton_poly(coeffs, 1.0, 1e-12)));

// ---- ODE RK4: dy/dt = y, y0=1, t∈[0,1] → y(1)=e≈2.7182818 ----
let traj = sci.rk4_linear(1.0, 1.0, 0.0, 1.0, 10);
print("rk4_linear dy/dt=y @1     = " + str(traj[10]));                  // ≈2.7183
print("rk4_linear last of 11 pts = " + str(len(traj)));

// dy/dt = t  (i.e. y' = 1*t^1, coeffs=[0,1])，y0=0 → y(1)=0.5
let traj2 = sci.rk4_poly([0.0, 1.0], 0.0, 0.0, 1.0, 10);
print("rk4_poly y'=t @1          = " + str(traj2[10]));                 // ≈0.5

// dy/dt = -2*y + 1 (affine)，y0=0 → y(1) = 0.5*(1-e^{-2}) ≈ 0.4323
let traj3 = sci.rk4_affine(-2.0, 1.0, 0.0, 0.0, 1.0, 20);
print("rk4_affine y'=-2y+1 @1    = " + str(traj3[20]));                 // ≈0.4323
