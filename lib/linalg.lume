// linalg.lume — 线性代数算法库（混合分层：.lume 算法层，零 C 摩擦）
//
// 矩阵用 list-of-list 表示：float[][]，约定 M[row][col]。
// 因 lume 的 list 为值语义（不支持 r[i][j] = x 原地赋值），所有「修改」
// 都通过返回新矩阵的帮助函数实现（mat_elim / mat_row_scale / mat_swap_rows
// / mat_set），三后端（解释器 / 文本 IR / LLVM）执行同一份 AST，故数值
// 天然一致，无需像 C native 那样手写镜像。
//
// 覆盖：
//   构造        mat_identity / mat_diag / mat_scale / mat_trace / mat_transpose
//   运算        mat_add / mat_sub / mat_mul
//   行列式      mat_det
//   求解        mat_solve(A, b)                 高斯消元 + 部份主元
//   求逆        mat_inv(A)                      Gauss–Jordan
//   LU 分解     lu_decompose(A)                 返回紧凑 LU（含置换）
//               lu_l(LU) / lu_u(LU)            从紧凑 LU 提取 L / U
//   工具        mat_eq_approx(A, B, tol)        容差比较（测试/演示用）
//
// 使用：
//   import "linalg.lume" as la;
//   let R = la.mat_mul(A, la.mat_inv(B));
//
// ── 设计说明 ───────────────────────────────────────────────────────
// 本库聚焦直接法（高斯消元 / Gauss–Jordan / Doolittle LU / QR / 特征值 /
// SVD），覆盖绝大多数中小规模线性代数需求。迭代法（共轭梯度、梯度下降等）
// 置于 optim.lume（已支持「用户函数接收函数类型形参」）。三后端执行同一
// 份 AST，浮点运算顺序由 lume 显式控制，故数值天然一致。
// ───────────────────────────────────────────────────────────────────

export let LINALG_VERSION = "0.1.0";

// ════════════════════════════════════════════════════════════════
// 内部帮助函数（函数式构造新矩阵，避免原地赋值）
// ════════════════════════════════════════════════════════════════

// 返回第 i 行（深拷贝，避免后续构造误改原矩阵）。
func la_copy_row(M: float[][], i: int): float[] {
  let nc = len(M[i]);
  let out: float[] = [];
  for (let k = 0; k < nc; k = k + 1) {
    out = push(out, M[i][k]);
  }
  return out;
}

// 返回新矩阵：其中第 i 行 = 原 row_i + f * row_p。
func la_elim(M: float[][], i: int, p: int, f: float): float[][] {
  let m = len(M);
  let out: float[][] = [];
  for (let r = 0; r < m; r = r + 1) {
    if (r == i) {
      let oi: float[] = M[i];
      let np: float[] = M[p];
      let nc = len(oi);
      let nr: float[] = [];
      for (let c = 0; c < nc; c = c + 1) {
        nr = push(nr, oi[c] + f * np[c]);
      }
      out = push(out, nr);
    } else {
      out = push(out, M[r]);
    }
  }
  return out;
}

// 返回新矩阵：第 i 行整体乘以 s。
func la_row_scale(M: float[][], i: int, s: float): float[][] {
  let m = len(M);
  let out: float[][] = [];
  for (let r = 0; r < m; r = r + 1) {
    if (r == i) {
      let oi: float[] = M[i];
      let nc = len(oi);
      let nr: float[] = [];
      for (let c = 0; c < nc; c = c + 1) {
        nr = push(nr, oi[c] * s);
      }
      out = push(out, nr);
    } else {
      out = push(out, M[r]);
    }
  }
  return out;
}

// 返回新矩阵：交换第 a、b 行。
func la_swap_rows(M: float[][], a: int, b: int): float[][] {
  let m = len(M);
  let out: float[][] = [];
  for (let r = 0; r < m; r = r + 1) {
    if (r == a) { out = push(out, M[b]); }
    else if (r == b) { out = push(out, M[a]); }
    else { out = push(out, M[r]); }
  }
  return out;
}

// 返回新矩阵：第 i 行第 j 列置为 v。
func la_set(M: float[][], i: int, j: int, v: float): float[][] {
  let m = len(M);
  let out: float[][] = [];
  for (let r = 0; r < m; r = r + 1) {
    if (r == i) {
      let oi: float[] = M[i];
      let nc = len(oi);
      let nr: float[] = [];
      for (let c = 0; c < nc; c = c + 1) {
        if (c == j) { nr = push(nr, v); }
        else { nr = push(nr, oi[c]); }
      }
      out = push(out, nr);
    } else {
      out = push(out, M[r]);
    }
  }
  return out;
}

// 反转 float[]（回代时自尾部累积解，最后翻转为正序）。
func la_reverse(xs: float[]): float[] {
  let n = len(xs);
  let out: float[] = [];
  for (let i = n - 1; i >= 0; i = i - 1) {
    out = push(out, xs[i]);
  }
  return out;
}

// ════════════════════════════════════════════════════════════════
// 构造 / 基础运算
// ════════════════════════════════════════════════════════════════

// n 阶单位阵。
export func mat_identity(n: int): float[][] {
  let out: float[][] = [];
  for (let i = 0; i < n; i = i + 1) {
    let row: float[] = [];
    for (let j = 0; j < n; j = j + 1) {
      if (i == j) { row = push(row, 1.0); }
      else { row = push(row, 0.0); }
    }
    out = push(out, row);
  }
  return out;
}

// 由向量构造对角阵。
export func mat_diag(v: float[]): float[][] {
  let n = len(v);
  let out: float[][] = [];
  for (let i = 0; i < n; i = i + 1) {
    let row: float[] = [];
    for (let j = 0; j < n; j = j + 1) {
      if (i == j) { row = push(row, v[i]); }
      else { row = push(row, 0.0); }
    }
    out = push(out, row);
  }
  return out;
}

// 转置 A^T。
export func mat_transpose(A: float[][]): float[][] {
  let m = len(A);
  let n = len(A[0]);
  let out: float[][] = [];
  for (let j = 0; j < n; j = j + 1) {
    let row: float[] = [];
    for (let i = 0; i < m; i = i + 1) {
      row = push(row, A[i][j]);
    }
    out = push(out, row);
  }
  return out;
}

// 标量乘：s * A。
export func mat_scale(A: float[][], s: float): float[][] {
  let m = len(A);
  let out: float[][] = [];
  for (let i = 0; i < m; i = i + 1) {
    let oi: float[] = A[i];
    let nc = len(oi);
    let row: float[] = [];
    for (let j = 0; j < nc; j = j + 1) {
      row = push(row, oi[j] * s);
    }
    out = push(out, row);
  }
  return out;
}

// 矩阵加 C = A + B。
export func mat_add(A: float[][], B: float[][]): float[][] {
  let m = len(A);
  let n = len(A[0]);
  let out: float[][] = [];
  for (let i = 0; i < m; i = i + 1) {
    let row: float[] = [];
    for (let j = 0; j < n; j = j + 1) {
      row = push(row, A[i][j] + B[i][j]);
    }
    out = push(out, row);
  }
  return out;
}

// 矩阵减 C = A - B。
export func mat_sub(A: float[][], B: float[][]): float[][] {
  let m = len(A);
  let n = len(A[0]);
  let out: float[][] = [];
  for (let i = 0; i < m; i = i + 1) {
    let row: float[] = [];
    for (let j = 0; j < n; j = j + 1) {
      row = push(row, A[i][j] - B[i][j]);
    }
    out = push(out, row);
  }
  return out;
}

// 矩阵乘 C = A * B。
export func mat_mul(A: float[][], B: float[][]): float[][] {
  let m = len(A);
  let n = len(B[0]);
  let p = len(B);
  let out: float[][] = [];
  for (let i = 0; i < m; i = i + 1) {
    let row: float[] = [];
    for (let j = 0; j < n; j = j + 1) {
      let s = 0.0;
      for (let k = 0; k < p; k = k + 1) {
        s = s + A[i][k] * B[k][j];
      }
      row = push(row, s);
    }
    out = push(out, row);
  }
  return out;
}

// 迹（方阵对角线之和）。
export func mat_trace(A: float[][]): float {
  let n = len(A);
  let t = 0.0;
  for (let i = 0; i < n; i = i + 1) {
    t = t + A[i][i];
  }
  return t;
}

// 容差比较：两矩阵在 tol 内逐元素相等。
export func mat_eq_approx(A: float[][], B: float[][], tol: float): bool {
  let m = len(A);
  let n = len(A[0]);
  for (let i = 0; i < m; i = i + 1) {
    for (let j = 0; j < n; j = j + 1) {
      if (abs(A[i][j] - B[i][j]) > tol) { return false; }
    }
  }
  return true;
}

// ════════════════════════════════════════════════════════════════
// 行列式（高斯消元 → 上三角，对角积 × 置换符号；部份主元）
// ════════════════════════════════════════════════════════════════

export func mat_det(A: float[][]): float {
  let n = len(A);
  let U: float[][] = [];
  for (let i = 0; i < n; i = i + 1) {
    let row: float[] = la_copy_row(A, i);
    U = push(U, row);
  }
  let sign = 1.0;
  for (let col = 0; col < n; col = col + 1) {
    let piv = col;
    let maxv: float = abs(U[col][col]);
    for (let r = col + 1; r < n; r = r + 1) {
      let av: float = abs(U[r][col]);
      if (av > maxv) { maxv = av; piv = r; }
    }
    if (maxv < 1e-12) { return 0.0; }   // 近奇异
    if (piv != col) { U = la_swap_rows(U, col, piv); sign = -sign; }
    let diag = U[col][col];
    for (let rr = col + 1; rr < n; rr = rr + 1) {
      let f = U[rr][col] / diag;
      U = la_elim(U, rr, col, -f);
    }
  }
  let d = sign;
  for (let ii = 0; ii < n; ii = ii + 1) {
    d = d * U[ii][ii];
  }
  return d;
}

// ════════════════════════════════════════════════════════════════
// 求解 Ax = b（高斯消元 + 部份主元，单右端 b: float[]）
// ════════════════════════════════════════════════════════════════

export func mat_solve(A: float[][], b: float[]): float[] {
  let n = len(A);
  // 构造增广矩阵 [A | b]
  let M: float[][] = [];
  for (let i = 0; i < n; i = i + 1) {
    let row: float[] = la_copy_row(A, i);
    row = push(row, b[i]);
    M = push(M, row);
  }
  // 前向消元
  for (let col = 0; col < n; col = col + 1) {
    let piv = col;
    let maxv: float = abs(M[col][col]);
    for (let r = col + 1; r < n; r = r + 1) {
      let av: float = abs(M[r][col]);
      if (av > maxv) { maxv = av; piv = r; }
    }
    if (piv != col) { M = la_swap_rows(M, col, piv); }
    let diag = M[col][col];
    for (let rr = col + 1; rr < n; rr = rr + 1) {
      let f = M[rr][col] / diag;
      M = la_elim(M, rr, col, -f);
    }
  }
  // 回代（自尾部累积，最后翻转）
  let xsol: float[] = [];
  for (let ii = n - 1; ii >= 0; ii = ii - 1) {
    let s = M[ii][n];
    for (let j = ii + 1; j < n; j = j + 1) {
      s = s - M[ii][j] * xsol[n - 1 - j];
    }
    let xi: float = s / M[ii][ii];
    xsol = push(xsol, xi);
  }
  return la_reverse(xsol);
}

// ════════════════════════════════════════════════════════════════
// 求逆 A^{-1}（Gauss–Jordan，增广 [A | I] → [I | A^{-1}]）
// ════════════════════════════════════════════════════════════════

export func mat_inv(A: float[][]): float[][] {
  let n = len(A);
  let M: float[][] = [];
  for (let i = 0; i < n; i = i + 1) {
    let row: float[] = la_copy_row(A, i);
    for (let j = 0; j < n; j = j + 1) {
      if (i == j) { row = push(row, 1.0); }
      else { row = push(row, 0.0); }
    }
    M = push(M, row);
  }
  for (let col = 0; col < n; col = col + 1) {
    let piv = col;
    let maxv: float = abs(M[col][col]);
    for (let r = col + 1; r < n; r = r + 1) {
      let av: float = abs(M[r][col]);
      if (av > maxv) { maxv = av; piv = r; }
    }
    if (piv != col) { M = la_swap_rows(M, col, piv); }
    let diag = M[col][col];
    M = la_row_scale(M, col, 1.0 / diag);
    for (let rr = 0; rr < n; rr = rr + 1) {
      if (rr != col) {
        let f = M[rr][col];
        M = la_elim(M, rr, col, -f);
      }
    }
  }
  // 取右侧 n 列
  let inv: float[][] = [];
  for (let ii = 0; ii < n; ii = ii + 1) {
    let row: float[] = [];
    for (let jj = n; jj < 2 * n; jj = jj + 1) {
      row = push(row, M[ii][jj]);
    }
    inv = push(inv, row);
  }
  return inv;
}

// ════════════════════════════════════════════════════════════════
// LU 分解（Doolittle + 部份主元），返回紧凑 LU：
//   i < j  →  U[i][j]
//   i == j →  U[i][j]（L 对角隐为 1）
//   i > j  →  L[i][j]
// 注意：带主元交换时满足 PA = LU（P 为行置换），即 L·U 重建的是「行置换后的 A」，
//       而非原 A（无交换时二者相同）。可用 lu_l/lu_u 分别提取 L、U 验证。
// ════════════════════════════════════════════════════════════════

export func lu_decompose(A: float[][]): float[][] {
  let n = len(A);
  let LU: float[][] = [];
  for (let i = 0; i < n; i = i + 1) {
    let row: float[] = la_copy_row(A, i);
    LU = push(LU, row);
  }
  for (let col = 0; col < n; col = col + 1) {
    let piv = col;
    let maxv: float = abs(LU[col][col]);
    for (let r = col + 1; r < n; r = r + 1) {
      let av: float = abs(LU[r][col]);
      if (av > maxv) { maxv = av; piv = r; }
    }
    if (maxv < 1e-12) { return LU; }   // 近奇异，返回当前（含 0 主元）
    if (piv != col) { LU = la_swap_rows(LU, col, piv); }
    let diag = LU[col][col];
    for (let rr = col + 1; rr < n; rr = rr + 1) {
      let f = LU[rr][col] / diag;
      // L[rr][col] = f（填下三角），同时消 U 的上方项
      LU = la_set(LU, rr, col, f);
      for (let c = col + 1; c < n; c = c + 1) {
        let v: float = LU[rr][c] - f * LU[col][c];
        LU = la_set(LU, rr, c, v);
      }
    }
  }
  return LU;
}

// 从紧凑 LU 提取 L（单位对角）。
export func lu_l(LU: float[][]): float[][] {
  let n = len(LU);
  let out: float[][] = [];
  for (let i = 0; i < n; i = i + 1) {
    let row: float[] = [];
    for (let j = 0; j < n; j = j + 1) {
      if (i == j) { row = push(row, 1.0); }
      else if (i > j) { row = push(row, LU[i][j]); }
      else { row = push(row, 0.0); }
    }
    out = push(out, row);
  }
  return out;
}

// 从紧凑 LU 提取 U（上三角，含对角）。
export func lu_u(LU: float[][]): float[][] {
  let n = len(LU);
  let out: float[][] = [];
  for (let i = 0; i < n; i = i + 1) {
    let row: float[] = [];
    for (let j = 0; j < n; j = j + 1) {
      if (i <= j) { row = push(row, LU[i][j]); }
      else { row = push(row, 0.0); }
    }
    out = push(out, row);
  }
  return out;
}

// ════════════════════════════════════════════════════════════════
// QR 分解 + 特征值 + SVD（2026-11-05，补线性代数库直接法缺口）
//
// 采用修改 Gram–Schmidt（MGS）正交化：O(n³)、全显式循环，浮点运算顺序
// 由 lume 显式控制，故三后端天然一致。复数特征值以「实部」返回（对称矩阵
// 必为实数，非对称可能含复根，本库只取实部；需完整复特征对请外接 sci.sig）。
//
// 覆盖：
//   mat_qr_q      A=QR 的正交因子 Q（列正交）
//   mat_qr_r      A=QR 的上三角因子 R
//   mat_eig_power 幂迭代：主特征值 λ 与对应特征向量 v（返回 [[λ], v]）
//   mat_eigvals   QR 迭代：全特征值（对称矩阵收敛到 diag(λ₁…λₙ)）
//   mat_svd       A=U·diag(s)·Vᵀ 奇异值分解（Jacobi，返回 packing）
//   mat_singular_values  仅返回降序奇异值 float[]
// ───────────────────────────────────────────────────────────────────

// 修改 Gram–Schmidt：返回正交矩阵 Q 使 A ≈ Q·R（R 上三角）。
// 列 j 依次为 A 各列对前 j-1 个正交列的残差归一化。
export func mat_qr_q(A: float[][]): float[][] {
  let m: int = len(A);
  let n: int = len(A[0]);
  let Qcols: float[][] = [];          // 列主序暂存（Qcols[j] 为第 j 列）
  for (let j = 0; j < n; j = j + 1) {
    let v: float[] = [];
    for (let i = 0; i < m; i = i + 1) { v = push(v, A[i][j]); }
    for (let i = 0; i < j; i = i + 1) {
      let dot: float = 0.0;
      for (let k = 0; k < m; k = k + 1) { dot = dot + Qcols[i][k] * v[k]; }
      let w: float[] = [];            // v = v - dot · Qcols[i]
      for (let k = 0; k < m; k = k + 1) { w = push(w, v[k] - dot * Qcols[i][k]); }
      v = w;
    }
    let norm: float = 0.0;
    for (let k = 0; k < m; k = k + 1) { norm = norm + v[k] * v[k]; }
    norm = sqrt(norm);
    if (norm < 1e-14) { norm = 1e-14; }
    let qcol: float[] = [];
    for (let k = 0; k < m; k = k + 1) { qcol = push(qcol, v[k] / norm); }
    Qcols = push(Qcols, qcol);
  }
  // 列主序 → 行主序
  let Q: float[][] = [];
  for (let k = 0; k < m; k = k + 1) {
    let row: float[] = [];
    for (let j = 0; j < n; j = j + 1) { row = push(row, Qcols[j][k]); }
    Q = push(Q, row);
  }
  return Q;
}

// 修改 Gram–Schmidt：返回上三角矩阵 R（与 mat_qr_q 共用同一分解，独立重算）。
export func mat_qr_r(A: float[][]): float[][] {
  let m: int = len(A);
  let n: int = len(A[0]);
  let Qcols: float[][] = [];
  let Rcols: float[][] = [];          // Rcols[j] 为第 j 列（长度 j+1，存 R[0..j][j]）
  for (let j = 0; j < n; j = j + 1) {
    let v: float[] = [];
    for (let i = 0; i < m; i = i + 1) { v = push(v, A[i][j]); }
    let rcol: float[] = [];
    for (let i = 0; i < j; i = i + 1) {
      let dot: float = 0.0;
      for (let k = 0; k < m; k = k + 1) { dot = dot + Qcols[i][k] * v[k]; }
      rcol = push(rcol, dot);
      let w: float[] = [];
      for (let k = 0; k < m; k = k + 1) { w = push(w, v[k] - dot * Qcols[i][k]); }
      v = w;
    }
    let norm: float = 0.0;
    for (let k = 0; k < m; k = k + 1) { norm = norm + v[k] * v[k]; }
    norm = sqrt(norm);
    if (norm < 1e-14) { norm = 1e-14; }
    rcol = push(rcol, norm);
    let qcol: float[] = [];
    for (let k = 0; k < m; k = k + 1) { qcol = push(qcol, v[k] / norm); }
    Qcols = push(Qcols, qcol);
    Rcols = push(Rcols, rcol);
  }
  // 列主序（上三角）→ 行主序
  let R: float[][] = [];
  for (let i = 0; i < n; i = i + 1) {
    let row: float[] = [];
    for (let j = 0; j < n; j = j + 1) {
      if (j < i) { row = push(row, 0.0); }
      else { row = push(row, Rcols[j][i]); }
    }
    R = push(R, row);
  }
  return R;
}

// 幂迭代：求（模最大）主特征值 λ 与对应单位特征向量 v。
// 返回 [[λ], v]（float[][]，首行为单元素 [λ]，次行为特征向量）。
// 适用于主特征值占优的矩阵（含对称矩阵）；迭代 iters 次取 Rayleigh 商。
export func mat_eig_power(A: float[][], iters: int): float[][] {
  let n: int = len(A);
  let v: float[] = [];
  for (let i = 0; i < n; i = i + 1) { v = push(v, 1.0 / sqrt(float(n))); }
  let lambda: float = 0.0;
  for (let it = 0; it < iters; it = it + 1) {
    let w: float[] = [];              // w = A·v
    for (let i = 0; i < n; i = i + 1) {
      let s: float = 0.0;
      for (let j = 0; j < n; j = j + 1) { s = s + A[i][j] * v[j]; }
      w = push(w, s);
    }
    let ray: float = 0.0;             // Rayleigh 商 λ = vᵀAv（v 已单位化）
    for (let i = 0; i < n; i = i + 1) { ray = ray + v[i] * w[i]; }
    lambda = ray;
    let nv: float = 0.0;
    for (let i = 0; i < n; i = i + 1) { nv = nv + w[i] * w[i]; }
    nv = sqrt(nv);
    if (nv < 1e-14) { nv = 1.0; }
    let vn: float[] = [];
    for (let i = 0; i < n; i = i + 1) { vn = push(vn, w[i] / nv); }
    v = vn;
  }
  let out: float[][] = [];
  out = push(out, [lambda]);
  out = push(out, v);
  return out;
}

// QR 迭代求全特征值：反复 A_{k+1} = R_k·Q_k，对角元素收敛到特征值。
// 对称矩阵收敛到对角阵（特征值全实）；返回对角线 float[]（顺序不定）。
export func mat_eigvals(A: float[][], iters: int): float[] {
  let n: int = len(A);
  let Ak: float[][] = [];
  for (let i = 0; i < n; i = i + 1) { Ak = push(Ak, la_copy_row(A, i)); }
  for (let it = 0; it < iters; it = it + 1) {
    let Q: float[][] = mat_qr_q(Ak);
    let R: float[][] = mat_qr_r(Ak);
    Ak = mat_mul(R, Q);
  }
  let out: float[] = [];
  for (let i = 0; i < n; i = i + 1) { out = push(out, Ak[i][i]); }
  return out;
}

// 反幂迭代：求最接近 μ（且不恰好等于）的特征值对应的单位特征向量。
// 迭代 v_{k+1} = (A − μI)^{-1} v_k 并归一化；收敛到离 μ 最近的特征值特征向量。
// 复用 mat_solve 解线性方程组。注意：μ 应接近目标特征值但不与之相等，
// 否则 (A − μI) 奇异导致 mat_solve 退化（用微小偏移即可，如 λ + 1e-3）。
export func mat_eigvec(A: float[][], mu: float, iters: int): float[] {
  let n: int = len(A);
  let v: float[] = [];
  for (let i = 0; i < n; i = i + 1) { v = push(v, 1.0 / sqrt(float(n))); }
  // 构造 M = A − μI
  let M: float[][] = [];
  for (let i = 0; i < n; i = i + 1) {
    let row: float[] = [];
    for (let j = 0; j < n; j = j + 1) {
      if (i == j) { row = push(row, A[i][j] - mu); }
      else { row = push(row, A[i][j]); }
    }
    M = push(M, row);
  }
  for (let it = 0; it < iters; it = it + 1) {
    let w: float[] = mat_solve(M, v);      // 解 (A − μI) x = v
    let nv: float = 0.0;
    for (let i = 0; i < n; i = i + 1) { nv = nv + w[i] * w[i]; }
    nv = sqrt(nv);
    if (nv < 1e-14) { nv = 1.0; }
    let vn: float[] = [];
    for (let i = 0; i < n; i = i + 1) { vn = push(vn, w[i] / nv); }
    v = vn;
  }
  return v;
}

// 完整特征分解：QR 迭代求特征值，再对每个特征值用反幂迭代求对应特征向量。
// 返回 [eigenvalues, eigenvectors]：eigenvalues 为 float[]（对角），
// eigenvectors 为 float[][]（第 i 行为对应特征向量，已单位化）。
export func mat_eig_decomp(A: float[][], iters: int): float[][] {
  let n: int = len(A);
  let evals: float[] = mat_eigvals(A, iters);
  let evecs: float[][] = [];
  for (let i = 0; i < n; i = i + 1) {
    let mu: float = evals[i] + 1e-3;       // 微小偏移避免 (A − μI) 奇异
    evecs = push(evecs, mat_eigvec(A, mu, iters));
  }
  let out: float[][] = [];
  out = push(out, evals);
  out = push(out, evecs);
  return out;
}

// 返回新矩阵：交换第 a、b 列（值语义，避免原地索引赋值）。
func la_swap_cols(M: float[][], a: int, b: int): float[][] {
  let m = len(M);
  let n = len(M[0]);
  let out: float[][] = [];
  for (let i = 0; i < m; i = i + 1) {
    let row: float[] = [];
    for (let j = 0; j < n; j = j + 1) {
      if (j == a) { row = push(row, M[i][b]); }
      else if (j == b) { row = push(row, M[i][a]); }
      else { row = push(row, M[i][j]); }
    }
    out = push(out, row);
  }
  return out;
}

// 返回新矩阵：对第 p、q 列施加正交旋转 [c -s; s c]（列右乘，值语义）。
func la_rot_cols(M: float[][], p: int, q: int, c: float, s: float): float[][] {
  let m = len(M);
  let n = len(M[0]);
  let out: float[][] = [];
  for (let i = 0; i < m; i = i + 1) {
    let row: float[] = [];
    for (let j = 0; j < n; j = j + 1) {
      if (j == p) { row = push(row, c * M[i][p] - s * M[i][q]); }
      else if (j == q) { row = push(row, s * M[i][p] + c * M[i][q]); }
      else { row = push(row, M[i][j]); }
    }
    out = push(out, row);
  }
  return out;
}

// ════════════════════════════════════════════════════════════════
// 奇异值分解 SVD（2026-11-05，补矩阵分解三件套最后一块）
//
// 两面对角化 Jacobi：反复对列对 (p,q) 施加正交旋转，使 AᵀA 的非对角元
// 收敛到 0。记 B = A·V，则 B 列长为 ||A v_q|| = σ_q（奇异值），与旋转
// 方向无关 → 奇异值数值稳健；B 列归一化即左奇异向量 U，V 为累积旋转。
// 复用 mat_identity / mat_mul / mat_transpose / mat_diag。纯 .lume、三
// 后端一致。
//
// 返回 packing（ragged float[][]）：
//   packed[0 .. m-1]        U（m×m，列正交）
//   packed[m]               singular values（降序，长度 n）
//   packed[m+1 .. m+n-1]    V（n×n，列正交）
// 满足 A ≈ U · diag(s) · Vᵀ（square 严格成立，tol 内）。
// ════════════════════════════════════════════════════════════════

export func mat_svd(A: float[][]): float[][] {
  let m: int = len(A);
  let n: int = len(A[0]);
  // B = A 的拷贝（m×n）
  let B: float[][] = [];
  for (let i = 0; i < m; i = i + 1) {
    let brow: float[] = [];
    for (let j = 0; j < n; j = j + 1) { brow = push(brow, A[i][j]); }
    B = push(B, brow);
  }
  let V: float[][] = mat_identity(n);
  // 固定 60 次扫描（小矩阵足够收敛；近收敛后旋转量趋于 0，无害）
  for (let sw = 0; sw < 60; sw = sw + 1) {
    for (let p = 0; p < n; p = p + 1) {
      for (let q = p + 1; q < n; q = q + 1) {
        let App: float = 0.0;
        let Aqq: float = 0.0;
        let Apq: float = 0.0;
        for (let i = 0; i < m; i = i + 1) {
          App = App + B[i][p] * B[i][p];
          Aqq = Aqq + B[i][q] * B[i][q];
          Apq = Apq + B[i][p] * B[i][q];
        }
        // 仅当 off-diagonal 显著时才旋转（避免除零 / 无谓扰动）
        if (abs(Apq) > 1e-10 * sqrt(App * Aqq) + 1e-300) {
          let tau: float = (Aqq - App) / (2.0 * Apq);
          let t: float = 0.0;
          if (tau >= 0.0) { t = 1.0 / (tau + sqrt(tau * tau + 1.0)); }
          else { t = -1.0 / (-tau + sqrt(tau * tau + 1.0)); }
          let c: float = 1.0 / sqrt(t * t + 1.0);
          let s: float = t * c;
          B = la_rot_cols(B, p, q, c, s);
          V = la_rot_cols(V, p, q, c, s);
        }
      }
    }
  }
  // 奇异值 = B 各列范数
  let sig: float[] = [];
  for (let j = 0; j < n; j = j + 1) {
    let s2: float = 0.0;
    for (let i = 0; i < m; i = i + 1) { s2 = s2 + B[i][j] * B[i][j]; }
    sig = push(sig, sqrt(s2));
  }
  // 降序排序，并同步置换 B 列（→U 列）与 V 列
  for (let a = 0; a < n; a = a + 1) {
    let bi: int = a;
    for (let b = a + 1; b < n; b = b + 1) {
      if (sig[b] > sig[bi]) { bi = b; }
    }
      if (bi != a) {
        let sa_val: float = sig[a];
        let sb_val: float = sig[bi];
        let sig_new: float[] = [];
        for (let j = 0; j < n; j = j + 1) {
          if (j == a) { sig_new = push(sig_new, sb_val); }
          else if (j == bi) { sig_new = push(sig_new, sa_val); }
          else { sig_new = push(sig_new, sig[j]); }
        }
        sig = sig_new;
        B = la_swap_cols(B, a, bi);
        V = la_swap_cols(V, a, bi);
      }
  }
  // 左奇异向量 U（列主序构造，再转置为行主序）
  let Ucols: float[][] = [];
  for (let j = 0; j < n; j = j + 1) {
    let sv: float = sig[j];
    if (sv < 1e-14) { sv = 1e-14; }
    let col: float[] = [];
    for (let i = 0; i < m; i = i + 1) { col = push(col, B[i][j] / sv); }
    Ucols = push(Ucols, col);
  }
  // 若 m > n，用 Gram–Schmidt 补足剩余标准正交列
  for (let j = n; j < m; j = j + 1) {
    let cand: float[] = [];
    for (let i = 0; i < m; i = i + 1) {
      if (i == j) { cand = push(cand, 1.0); } else { cand = push(cand, 0.0); }
    }
    for (let k = 0; k < j; k = k + 1) {
      let dot: float = 0.0;
      for (let i = 0; i < m; i = i + 1) { dot = dot + Ucols[k][i] * cand[i]; }
      let nc: float[] = [];
      for (let i = 0; i < m; i = i + 1) { nc = push(nc, cand[i] - dot * Ucols[k][i]); }
      cand = nc;
    }
    let norm: float = 0.0;
    for (let i = 0; i < m; i = i + 1) { norm = norm + cand[i] * cand[i]; }
    norm = sqrt(norm);
    if (norm < 1e-14) { norm = 1.0; }
    let col: float[] = [];
    for (let i = 0; i < m; i = i + 1) { col = push(col, cand[i] / norm); }
    Ucols = push(Ucols, col);
  }
  let U: float[][] = [];
  for (let i = 0; i < m; i = i + 1) {
    let row: float[] = [];
    for (let j = 0; j < m; j = j + 1) { row = push(row, Ucols[j][i]); }
    U = push(U, row);
  }
  // packing（ragged）
  let out: float[][] = [];
  for (let i = 0; i < m; i = i + 1) { out = push(out, U[i]); }
  out = push(out, sig);
  for (let i = 0; i < n; i = i + 1) { out = push(out, V[i]); }
  return out;
}

// 仅返回降序奇异值（float[]，长度 n）；A = U·diag(s)·Vᵀ 的核心数值结果。
export func mat_singular_values(A: float[][]): float[] {
  let packed: float[][] = mat_svd(A);
  let m: int = len(A);
  return packed[m];
}
