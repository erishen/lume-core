// ════════════════════════════════════════════════════════════════
// pde.lume — 偏微分方程数值解库（有限差分）
// 版本：v0.2.0（2026-11-06，补「信息与计算科学」PDE 缺口；此前仅有 ODE rk4）
//        v0.2.0 增补 2D 热方程：pde_heat_2d（显式 FTCS，Dirichlet / Neumann
//        零通量边界）+ pde_heat_2d_adi（ADI 交替方向隐式，无条件稳定）。
//
// 覆盖三类经典 PDE 的有限差分法：
//   抛物型：pde_heat_explicit（1D FTCS 显式）/ pde_heat_cn（1D Crank–Nicolson 隐式）
//           pde_heat_2d（2D FTCS 显式，Dirichlet / Neumann 零通量边界）
//           pde_heat_2d_adi（2D ADI 隐式，复用 pde_tridiag，无条件稳定）
//   双曲型：pde_wave_leapfrog（蛙跳格式）
//   椭圆型：pde_poisson_jacobi（Jacobi 迭代解 ∇²u = f）
//
// 设计：纯 .lume、三后端一致；不接收 fn 形参（规避 lume 闭包跨函数捕获
//       局部变量的限制），初值/源项一律以预计算数组传入，边界条件以标量传入。
// 工具：pde_linspace（坐标数组）、pde_tridiag（Thomas 算法解三对角）、
//       pde_reverse（1D 反转）。所有网格更新均为值语义（用 push 整体重建）。
// ───────────────────────────────────────────────────────────────────

// 均匀坐标数组 [a, ..., b]，共 n 个点
export func pde_linspace(a: float, b: float, n: int): float[] {
  let dx: float = (b - a) / (n - 1.0);
  let xs: float[] = [];
  for (let i = 0; i < n; i = i + 1) {
    xs = push(xs, a + dx * i);
  }
  return xs;
}

// 反转子数组（1D，值语义）
func pde_reverse(a: float[]): float[] {
  let r: float[] = [];
  let n: int = len(a);
  for (let i = n - 1; i >= 0; i = i - 1) {
    r = push(r, a[i]);
  }
  return r;
}

// Thomas 算法：解三对角方程组 A x = d
//   A 的下/主/上对角线分别为 a[1..] / b[0..] / c[0..]（长度均为 n）
// 返回 x（float[]）。O(n)，值语义（用 push 重建，不索引赋值）。
export func pde_tridiag(a: float[], b: float[], c: float[], d: float[]): float[] {
  let n: int = len(b);
  let cp: float[] = [];
  let dp: float[] = [];
  cp = push(cp, c[0] / b[0]);
  dp = push(dp, d[0] / b[0]);
  for (let i = 1; i < n; i = i + 1) {
    let m: float = b[i] - a[i - 1] * cp[i - 1];
    cp = push(cp, c[i] / m);
    dp = push(dp, (d[i] - a[i - 1] * dp[i - 1]) / m);
  }
  // 回代：从右往左 push（xr[0]=x[n-1]，末尾为刚算出的 x[i+1]），再反转
  let xr: float[] = [];
  xr = push(xr, dp[n - 1]);
  for (let i = n - 2; i >= 0; i = i - 1) {
    xr = push(xr, dp[i] - cp[i] * xr[len(xr) - 1]);
  }
  return pde_reverse(xr);
}

// ── 抛物型：一维热方程 显式 FTCS ─────────────────────────────
// u_t = α u_xx，Dirichlet 边界 left_bc / right_bc。返回最终时刻 u（float[]）。
// 稳定性要求 r = α dt / dx² ≤ 0.5（由调用方保证）。
export func pde_heat_explicit(u0: float[], a: float, b: float, alpha: float,
                              dt: float, nt: int, left_bc: float, right_bc: float): float[] {
  let n: int = len(u0);
  let dx: float = (b - a) / (n - 1.0);
  let r: float = alpha * dt / (dx * dx);
  let u: float[] = u0;
  for (let step = 0; step < nt; step = step + 1) {
    let unew: float[] = [];
    unew = push(unew, left_bc);
    for (let i = 1; i < n - 1; i = i + 1) {
      unew = push(unew, u[i] + r * (u[i - 1] - 2.0 * u[i] + u[i + 1]));
    }
    unew = push(unew, right_bc);
    u = unew;
  }
  return u;
}

// ── 抛物型：一维热方程 隐式 Crank–Nicolson（无条件稳定）──────────
// 同左，但每步解三对角系统，故对大 dt 也稳定。
export func pde_heat_cn(u0: float[], a: float, b: float, alpha: float,
                        dt: float, nt: int, left_bc: float, right_bc: float): float[] {
  let n: int = len(u0);
  let dx: float = (b - a) / (n - 1.0);
  let r: float = alpha * dt / (dx * dx);
  let u: float[] = u0;
  let m: int = n - 2;                 // 内部未知量个数
  for (let step = 0; step < nt; step = step + 1) {
    let Aa: float[] = [];             // 次对角线（Aa[0] 不被读取）
    let Ab: float[] = [];             // 主对角线
    let Ac: float[] = [];             // 上对角线（Ac[m-1] 不被读取）
    let rhs: float[] = [];
    for (let k = 0; k < m; k = k + 1) {
      Ab = push(Ab, 1.0 + r);
      Ac = push(Ac, -r / 2.0);
      Aa = push(Aa, -r / 2.0);
      let idx: int = k + 1;           // u 的全局下标
      let ex: float = (r / 2.0) * u[idx - 1] + (1.0 - r) * u[idx] + (r / 2.0) * u[idx + 1];
      if (k == 0)        { ex = ex + (r / 2.0) * left_bc; }
      if (k == m - 1)    { ex = ex + (r / 2.0) * right_bc; }
      rhs = push(rhs, ex);
    }
    let uin: float[] = pde_tridiag(Aa, Ab, Ac, rhs);
    let unew: float[] = [];
    unew = push(unew, left_bc);
    for (let k = 0; k < m; k = k + 1) { unew = push(unew, uin[k]); }
    unew = push(unew, right_bc);
    u = unew;
  }
  return u;
}

// ── 抛物型：二维热方程 显式 FTCS（Dirichlet / Neumann 零通量）────
// u_t = α (u_xx + u_yy)，网格由 u0 (nx×ny) 给定，dx/dy 为步长。返回最终 u。
// neumann=true：四边界零通量（∂u/∂n=0，ghost-cell 镜像）；false：Dirichlet
//   边界固定为 0。稳定性要求 α dt (1/dx² + 1/dy²) ≤ 0.5（由调用方保证）。
// 值语义：每步由旧网格整体重建新网格（同 pde_poisson_jacobi）。

// 取邻居值并施加边界条件（越界即 ghost cell）：Neumann 镜像内部邻居，
// Dirichlet ghost 取 0。所有访问均在函数内做边界判断，绝不越界索引。
func pde_h2d_val(u: float[][], i: int, j: int, di: int, dj: int,
                 nx: int, ny: int, neumann: bool): float {
  let ii = i + di;
  let jj = j + dj;
  let v: float = 0.0;
  if (ii >= 0 && ii < nx && jj >= 0 && jj < ny) {
    v = u[ii][jj];
  } else {
    if (neumann) {
      let mi = ii;
      let mj = jj;
      if (ii < 0)    { mi = i + 1; }
      if (ii >= nx)  { mi = i - 1; }
      if (jj < 0)    { mj = j + 1; }
      if (jj >= ny)  { mj = j - 1; }
      v = u[mi][mj];
    } else {
      v = 0.0;
    }
  }
  return v;
}

export func pde_heat_2d(u0: float[][], dx: float, dy: float, alpha: float,
                        dt: float, nt: int, neumann: bool): float[][] {
  let nx = len(u0);
  let ny = len(u0[0]);
  let u: float[][] = u0;
  for (let step = 0; step < nt; step = step + 1) {
    let unew: float[][] = [];
    for (let i = 0; i < nx; i = i + 1) {
      let row: float[] = [];
      for (let j = 0; j < ny; j = j + 1) {
        let on_boundary = (i == 0 || i == nx - 1 || j == 0 || j == ny - 1);
        if (on_boundary && neumann == false) {
          row = push(row, 0.0);                 // Dirichlet 边界固定为 0
        } else {
          let uij: float  = u[i][j];
          // 本地函数返回值须显式标注（文本后端无法推断）
          let uim1: float = pde_h2d_val(u, i, j, -1, 0, nx, ny, neumann);
          let uip1: float = pde_h2d_val(u, i, j,  1, 0, nx, ny, neumann);
          let ujm1: float = pde_h2d_val(u, i, j, 0, -1, nx, ny, neumann);
          let ujp1: float = pde_h2d_val(u, i, j, 0,  1, nx, ny, neumann);
          let lap = (uip1 - 2.0 * uij + uim1) / (dx * dx)
                  + (ujp1 - 2.0 * uij + ujm1) / (dy * dy);
          row = push(row, uij + alpha * dt * lap);
        }
      }
      unew = push(unew, row);
    }
    u = unew;
  }
  return u;
}

// ── 抛物型：二维热方程 ADI 交替方向隐式（Peaceman–Rachford）──────
// u_t = α(u_xx + u_yy)，无条件稳定，可突破显式 FTCS 的 CFL 限制。
// 每步拆两个半步，各方向解一串三对角系统（复用 pde_tridiag）：
//   半步1（x 隐式 / y 显式）：(1+rx)u*_ij − (rx/2)(u*_{i−1,j}+u*_{i+1,j})
//                            = u^n_ij + (ry/2)(u^n_{i,j−1} − 2u^n_ij + u^n_{i,j+1})
//   半步2（y 隐式 / x 显式）：(1+ry)u^{n+1}_ij − (ry/2)(u^{n+1}_{i,j−1}+u^{n+1}_{i,j+1})
//                            = u*_ij + (rx/2)(u*_{i−1,j} − 2u*_ij + u*_{i+1,j})
// 其中 rx = αdt/dx²，ry = αdt/dy²。边界为**常数 Dirichlet 值 bc**（四边统一），
// 此时中间层 u* 的边界取 bc 精确成立。稳定性对任意 dt 成立（精度仍随 dt 下降）。

// 转置 n×p 矩阵 → p×n（支持非方阵，值语义整体重建）
func pde_transpose(m: float[][]): float[][] {
  let nr = len(m);
  let nc = len(m[0]);
  let out: float[][] = [];
  for (let c = 0; c < nc; c = c + 1) {
    let row: float[] = [];
    for (let r = 0; r < nr; r = r + 1) { row = push(row, m[r][c]); }
    out = push(out, row);
  }
  return out;
}

// 半步1：转置为 [j][i]，对每条固定 j 的行沿 i 解三对角，再转置回 [i][j]。
func pde_adi_x(u: float[][], nx: int, ny: int, rx: float, ry: float, bc: float): float[][] {
  let mx: int = nx - 2;                 // 沿 i 的内部未知量个数
  let ut: float[][] = pde_transpose(u);
  let ust: float[][] = [];
  for (let j = 0; j < ny; j = j + 1) {
    let row: float[] = [];
    if (j == 0 || j == ny - 1) {
      for (let q = 0; q < nx; q = q + 1) { row = push(row, bc); }   // y 边界行
    } else {
      let Aa: float[] = [];
      let Ab: float[] = [];
      let Ac: float[] = [];
      let rhs: float[] = [];
      for (let k = 0; k < mx; k = k + 1) {
        Ab = push(Ab, 1.0 + rx);
        Ac = push(Ac, -rx / 2.0);
        Aa = push(Aa, -rx / 2.0);
        let i: int = k + 1;
        let e: float = ut[j][i]
                     + (ry / 2.0) * (ut[j - 1][i] - 2.0 * ut[j][i] + ut[j + 1][i]);
        if (k == 0)      { e = e + (rx / 2.0) * bc; }               // i=1 左边界
        if (k == mx - 1) { e = e + (rx / 2.0) * bc; }               // i=nx−2 右边界
        rhs = push(rhs, e);
      }
      let sol: float[] = pde_tridiag(Aa, Ab, Ac, rhs);
      row = push(row, bc);
      for (let k2 = 0; k2 < mx; k2 = k2 + 1) { row = push(row, sol[k2]); }
      row = push(row, bc);
    }
    ust = push(ust, row);
  }
  return pde_transpose(ust);
}

// 半步2：在 [i][j] 视图下，对每条固定 i 的行沿 j 解三对角。
func pde_adi_y(us: float[][], nx: int, ny: int, rx: float, ry: float, bc: float): float[][] {
  let my: int = ny - 2;                 // 沿 j 的内部未知量个数
  let unew: float[][] = [];
  for (let i = 0; i < nx; i = i + 1) {
    let row: float[] = [];
    if (i == 0 || i == nx - 1) {
      for (let q = 0; q < ny; q = q + 1) { row = push(row, bc); }   // x 边界行
    } else {
      let Ba: float[] = [];
      let Bb: float[] = [];
      let Bc: float[] = [];
      let rhs: float[] = [];
      for (let k = 0; k < my; k = k + 1) {
        Bb = push(Bb, 1.0 + ry);
        Bc = push(Bc, -ry / 2.0);
        Ba = push(Ba, -ry / 2.0);
        let j: int = k + 1;
        let e: float = us[i][j]
                     + (rx / 2.0) * (us[i - 1][j] - 2.0 * us[i][j] + us[i + 1][j]);
        if (k == 0)      { e = e + (ry / 2.0) * bc; }               // j=1 下边界
        if (k == my - 1) { e = e + (ry / 2.0) * bc; }               // j=ny−2 上边界
        rhs = push(rhs, e);
      }
      let sol: float[] = pde_tridiag(Ba, Bb, Bc, rhs);
      row = push(row, bc);
      for (let k2 = 0; k2 < my; k2 = k2 + 1) { row = push(row, sol[k2]); }
      row = push(row, bc);
    }
    unew = push(unew, row);
  }
  return unew;
}

// ADI 主循环：每步 = 半步1 + 半步2。nt 步后到 t = t0 + nt·dt。
export func pde_heat_2d_adi(u0: float[][], dx: float, dy: float, alpha: float,
                            dt: float, nt: int, bc: float): float[][] {
  let nx: int = len(u0);
  let ny: int = len(u0[0]);
  let rx: float = alpha * dt / (dx * dx);
  let ry: float = alpha * dt / (dy * dy);
  let u: float[][] = u0;
  for (let step = 0; step < nt; step = step + 1) {
    let us: float[][] = pde_adi_x(u, nx, ny, rx, ry, bc);
    u = pde_adi_y(us, nx, ny, rx, ry, bc);
  }
  return u;
}

// ── 双曲型：一维波动方程 蛙跳格式 ─────────────────────────────
// u_tt = c² u_xx，零初速度（u_t(x,0)=0），Dirichlet 边界。返回最终时刻 u。
// 稳定性要求 Courant 数 C = c dt / dx ≤ 1（由调用方保证）。
export func pde_wave_leapfrog(u0: float[], a: float, b: float, c: float,
                              dt: float, nt: int, left_bc: float, right_bc: float): float[] {
  let n: int = len(u0);
  let dx: float = (b - a) / (n - 1.0);
  let C2: float = (c * dt / dx) * (c * dt / dx);
  // 第一步（由 u_t=0 推出）
  let u1: float[] = [];
  u1 = push(u1, left_bc);
  for (let i = 1; i < n - 1; i = i + 1) {
    u1 = push(u1, u0[i] + 0.5 * C2 * (u0[i - 1] - 2.0 * u0[i] + u0[i + 1]));
  }
  u1 = push(u1, right_bc);
  let uprev: float[] = u0;
  let ucur: float[] = u1;
  for (let step = 1; step < nt; step = step + 1) {
    let unext: float[] = [];
    unext = push(unext, left_bc);
    for (let i = 1; i < n - 1; i = i + 1) {
      unext = push(unext, 2.0 * ucur[i] - uprev[i]
                          + C2 * (ucur[i - 1] - 2.0 * ucur[i] + ucur[i + 1]));
    }
    unext = push(unext, right_bc);
    uprev = ucur;
    ucur = unext;
  }
  return ucur;
}

// ── 椭圆型：二维泊松方程 Jacobi 迭代 ∇²u = f ──────────────────
// f 为 n×n 网格源项；Dirichlet 边界固定为 0（零边界）。返回数值解 u（n×n）。
// 注：Jacobi 天然值语义——每步由旧网格整体重建新网格，无索引赋值。
export func pde_poisson_jacobi(f: float[][], h: float, iters: int): float[][] {
  let n: int = len(f);
  let u: float[][] = [];
  for (let i = 0; i < n; i = i + 1) {
    let row: float[] = [];
    for (let j = 0; j < n; j = j + 1) { row = push(row, 0.0); }
    u = push(u, row);
  }
  for (let it = 0; it < iters; it = it + 1) {
    let unew: float[][] = [];
    for (let i = 0; i < n; i = i + 1) {
      let row: float[] = [];
      for (let j = 0; j < n; j = j + 1) {
        if (i == 0 || i == n - 1 || j == 0 || j == n - 1) {
          row = push(row, 0.0);                       // 边界固定
        } else {
          let v: float = 0.25 * (u[i - 1][j] + u[i + 1][j]
                               + u[i][j - 1] + u[i][j + 1]
                               - h * h * f[i][j]);
          row = push(row, v);
        }
      }
      unew = push(unew, row);
    }
    u = unew;
  }
  return u;
}
