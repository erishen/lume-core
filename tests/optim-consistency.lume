// optim-consistency.lume — 最优化算法库三后端一致性套件
// （解释器 / 文本 IR / LLVM）输出逐字节一致。
// 运行：tests/optim_backends.sh
//
// 覆盖：least_squares / poly_fit / quad_min / conj_grad / linprog_simplex / golden_poly_min
// 注：quad_min / golden_poly_min 为迭代法，输出为收敛到的浮点值；三后端因执行同一
// 份 AST（浮点运算顺序由 lume 显式控制）必然逐字节一致，与具体精度无关。

import "../lib/optim.lume" as opt;

// 线性最小二乘：拟合 y = 2x + 1
let A = [[1.0,1.0],[1.0,2.0],[1.0,3.0]];
let b = [3.0,5.0,7.0];
print(opt.least_squares(A, b));                       // [1, 2]
print(opt.poly_fit([1.0,2.0,3.0],[3.0,5.0,7.0],1));  // [1, 2]

// 凸二次型梯度下降：f(x,y)=(x-1)^2+(y-2)^2 → 极小点 (1,2)
print(opt.quad_min([[2.0,0.0],[0.0,2.0]],[2.0,4.0],[0.0,0.0],300,0.1));   // ~[1,2]
// 一维：f(x)=0.5 x^2 + 2x → 极小点 x=-2
print(opt.quad_min([[1.0]], [-2.0], [0.0], 500, 0.05));                    // [-2]

// 共轭梯度解 SPD 系统：[[2,1],[1,3]]x=[3,5] → [0.8,1.4]
print(opt.conj_grad([[2.0,1.0],[1.0,3.0]],[3.0,5.0],[0.0,0.0],30,1e-9));   // [0.8,1.4]

// 线性规划（单纯形）
print(opt.linprog_simplex([3.0,2.0],[[1.0,1.0]],[4.0]));                  // [4,0]
print(opt.linprog_simplex([3.0,2.0],[[1.0,1.0],[2.0,1.0]],[4.0,6.0]));    // [2,2]

// 一元多项式极小：min (x-1)^2 on [0,3] → 1
print(opt.golden_poly_min([1.0,-2.0,1.0],0.0,3.0,1e-7));                  // ~1.0
