// tests/sqlite.lume — sql_query / sql_write regression (2026-10-12)
// 运行: make sql-test (并入 make test)。构建没编进 libsqlite3 时整段 SKIP:
// sql_* 名字在任何构建里都注册(stub 运行时报缺失), 所以探针用 try() 捕获
// 错误信息判断, 而不是假设名字存在与否。真正干活的第一个语句是 CREATE
// TABLE(stub 下报 unavailable, 真实现下成功)——只用 READONLY 打不开不存在的
// 文件库, ":memory:" 也开不了只读连接, 都不能当探针。

func check(name, cond) {
  if (cond) { print("PASS " + name); }
  else { print("FAIL " + name); }
}

func main(): int {
  // 每次运行一个新库文件(无法 unlink, 靠时间戳避免撞上次的库)。
  // sql_write 刻意不带 SQLITE_OPEN_CREATE(防手滑建库), 与宿主语义一致:
  // 先垫 0 字节空库文件——lume-nsgm 生成的 db.init 同款做法。
  let db = "/tmp/lume-sqlite-" + str(now()) + ".lume-test.db";
  write_file(db, "");

  let probe = try(() => {
    sql_write(db, "CREATE TABLE t (id integer primary key autoincrement, name text, score real)");
    return "ok";
  });
  if (get(probe, "err", null) != null) {
    print("SKIP sqlite: " + get(probe, "err"));
    return 0;
  }
  check("create table", get(probe, "ok") == "ok");

  // 带参 INSERT: 文本绑定, 数字走 affinity
  let i1 = sql_write(db, "INSERT INTO t (name, score) VALUES (?, ?)", ["张三", 3.5]);
  let i2 = sql_write(db, "INSERT INTO t (name, score) VALUES (?, ?)", ["李四", "9"]);
  let i3 = sql_write(db, "INSERT INTO t (name, score) VALUES (?, ?)", [null, 1.25]);
  check("insert affected 1", i1 == 1 and i2 == 1 and i3 == 1);

  // SELECT -> 行 map 列表
  let rows = sql_query(db, "SELECT id, name, score FROM t ORDER BY id");
  check("select count", len(rows) == 3);
  check("select text cell", get(rows[0], "name") == "张三");
  check("select float cell", get(rows[0], "score") == 3.5);
  check("select text-number affinity", get(rows[1], "score") == 9);
  check("select null cell", get(rows[2], "name") == null);

  // 空结果 -> []
  let none = sql_query(db, "SELECT id FROM t WHERE name = 'nobody'");
  check("select empty -> []", stringify(none) == "[]");

  // UPDATE 带 WHERE
  let u1 = sql_write(db, "UPDATE t SET score = ? WHERE name = ?", [4.75, "张三"]);
  check("update where affected", u1 == 1);
  let rows2 = sql_query(db, "SELECT score FROM t WHERE name = '张三'");
  check("update visible", get(rows2[0], "score") == 4.75);

  // DELETE 带 WHERE
  let d1 = sql_write(db, "DELETE FROM t WHERE name = ?", ["李四"]);
  check("delete where affected", d1 == 1);
  check("delete visible", len(sql_query(db, "SELECT id FROM t WHERE name = '李四'")) == 0);

  // 护栏: 无 WHERE 的 UPDATE / DELETE 拒绝
  let uw = try(() => { sql_write(db, "UPDATE t SET score = 0"); return "ok"; });
  check("update without where rejects", get(uw, "err", null) != null);
  let dw = try(() => { sql_write(db, "DELETE FROM t"); return "ok"; });
  check("delete without where rejects", get(dw, "err", null) != null);

  // 护栏: 危险 DDL / 多语句 / 非白名单
  let drop = try(() => { sql_write(db, "DROP TABLE t"); return "ok"; });
  check("drop rejects", get(drop, "err", null) != null);
  let pragma = try(() => { sql_query(db, "PRAGMA table_info(t)"); return "ok"; });
  check("pragma rejects", get(pragma, "err", null) != null);
  let multi = try(() => { sql_query(db, "SELECT 1; SELECT 2"); return "ok"; });
  check("multi-statement rejects", get(multi, "err", null) != null);
  let nonread = try(() => { sql_query(db, "DELETE FROM t"); return "ok"; });
  check("sql_query is read-only", get(nonread, "err", null) != null);

  // ALTER TABLE ADD COLUMN: 加列迁移通道（唯一放行的 ALTER，严格形状）
  // 探测现有列走 SELECT 前缀的 pragma_table_info 表值函数（只读连接可用）；
  // 语句式 PRAGMA 仍被读护栏拒（上面已验）。
  let cols0 = sql_query(db, "SELECT name FROM pragma_table_info('t')");
  check("pragma_table_info probe", len(cols0) == 3 && get(cols0[0], "name") == "id");
  let a1 = try(() => { sql_write(db, "ALTER TABLE t ADD COLUMN nickname TEXT"); return "ok"; });
  check("alter add column", get(a1, "err", null) == null);
  let cols1 = sql_query(db, "SELECT name FROM pragma_table_info('t')");
  check("column added", len(cols1) == 4 && get(cols1[3], "name") == "nickname");
  // 旧行新列读出来是 null：迁移只发裸类型，不带默认值（SQLite 也不允许
  // ADD COLUMN 带 CURRENT_TIMESTAMP 默认值）
  let rows3 = sql_query(db, "SELECT nickname FROM t WHERE name = '张三'");
  check("added col null on old row", len(rows3) == 1 && get(rows3[0], "nickname") == null);
  let up = sql_write(db, "UPDATE t SET nickname = ? WHERE name = ?", ["小张三", "张三"]);
  check("write added col", up == 1);
  check("added col readable",
    get(sql_query(db, "SELECT nickname FROM t WHERE name = '张三'")[0], "nickname") == "小张三");

  // 护栏: 非 ADD 形态的 ALTER / 类型段里的字符串字面量 / 多语句, 一律拒
  let ad = try(() => { sql_write(db, "ALTER TABLE t DROP COLUMN name"); return "ok"; });
  check("alter drop column rejects", get(ad, "err", null) != null);
  let ar = try(() => { sql_write(db, "ALTER TABLE t RENAME TO u"); return "ok"; });
  check("alter rename rejects", get(ar, "err", null) != null);
  let ac = try(() => { sql_write(db, "ALTER TABLE t ADD COLUMN x TEXT DEFAULT 'y'"); return "ok"; });
  check("alter add string default rejects", get(ac, "err", null) != null);
  let at = try(() => { sql_write(db, "ALTER TABLE t ADD COLUMN x TEXT); DROP TABLE t"); return "ok"; });
  check("alter add multi-statement rejects", get(at, "err", null) != null);
  let an = try(() => { sql_write(db, "ALTER TABLE t ADD COLUMN"); return "ok"; });
  check("alter add missing type rejects", get(an, "err", null) != null);
  // 加列后表仍可正常增删查（迁移不破坏既有通道）
  let i4 = sql_write(db, "INSERT INTO t (name, nickname) VALUES (?, ?)", ["王五", "小王五"]);
  check("insert after alter", i4 == 1);
  check("select after alter", len(sql_query(db, "SELECT nickname FROM t")) == 3);

  // ---- write-CTE 灰区(2026-10-20): WITH 前缀 + 单条白名单写语句 ----
  // 只读 CTE 放行: SELECT 子查询 + INSERT ... SELECT 主体(SQLite 3.8.3+)
  let c1 = sql_write(db, "WITH c AS (SELECT ? AS a) INSERT INTO t (name) SELECT a FROM c", ["CTE-one"]);
  check("with select cte insert", c1 == 1);
  check("with select cte visible",
    len(sql_query(db, "SELECT name FROM t WHERE name = 'CTE-one'")) == 1);
  // VALUES 变体 + 列清单
  let c2 = sql_write(db, "WITH c (nm) AS (VALUES ('v1')) INSERT INTO t (name) SELECT nm FROM c");
  check("with values cte insert", c2 == 1);
  check("with values cte visible",
    len(sql_query(db, "SELECT name FROM t WHERE name = 'v1'")) == 1);
  // 多 CTE
  let c3 = sql_write(db,
    "WITH c AS (SELECT 1 AS a), d AS (SELECT 'multi' AS b) INSERT INTO t (name) SELECT b FROM d");
  check("with multi cte insert", c3 == 1);
  // 只读 CTE + 主体 UPDATE 带 WHERE(0 行也走校验放行)
  let c4 = sql_write(db, "WITH c AS (SELECT 1) UPDATE t SET score = 0 WHERE name = 'nobody'");
  check("with cte body update where", c4 == 0);
  // CTE 内 WHERE 不豁免主体无 WHERE UPDATE(校验作用于主体文本, 非整句)
  let n1 = try(() => { sql_write(db, "WITH c AS (SELECT 1 WHERE 1) UPDATE t SET score = 0"); return "ok"; });
  check("cte where not exempt body update", get(n1, "err", null) != null);
  // CTE 内 DML: 一律直拒。SQLite 任何版本都没有"数据修改 CTE"——2026-10-21
  // 用系统库 3.51.0 实证, 连文档里的 PostgreSQL 形状
  // (WITH u AS (UPDATE ... RETURNING ...) SELECT ...) 都在 prepare 期报
  // near "UPDATE" 语法错。3.35 加的是顶层 DML 的 RETURNING, 不是 CTE 内 DML。
  // 守卫早先为想象中的"RETURNING DML 头"开过口子, 放行的语句到 prepare 才死,
  // 报错是一句没名字的引擎语法错误; 现在在护栏层就给名字明确的拒绝。
  let n2 = try(() => { sql_write(db, "WITH c AS (INSERT INTO t (name) VALUES ('x')) SELECT 1"); return "ok"; });
  check("cte insert body rejected", get(n2, "err", null) != null);
  let n3 = try(() => { sql_write(db, "WITH c AS (UPDATE t SET score = 0 RETURNING name) SELECT 1"); return "ok"; });
  check("cte update body rejected", get(n3, "err", null) != null);
  let n4 = try(() => { sql_write(db, "WITH c AS (DELETE FROM t RETURNING name) SELECT 1"); return "ok"; });
  check("cte delete body rejected", get(n4, "err", null) != null);
  // CTE 内危险词 / 主体非白名单 / 无尾语句 / 多语句
  let n5 = try(() => { sql_write(db, "WITH c AS (DROP TABLE t) INSERT INTO t (name) VALUES ('x')"); return "ok"; });
  check("cte drop rejects", get(n5, "err", null) != null);
  let n6 = try(() => { sql_write(db, "WITH c AS (SELECT 1) CREATE TABLE u (id int)"); return "ok"; });
  check("with create body rejects", get(n6, "err", null) != null);
  let n7 = try(() => { sql_write(db, "WITH c AS (SELECT 1)"); return "ok"; });
  check("with no trailing stmt rejects", get(n7, "err", null) != null);
  let n8 = try(() => { sql_write(db, "WITH c AS (SELECT 1) INSERT INTO t (name) VALUES ('x'); DROP TABLE t"); return "ok"; });
  check("with multi-statement rejects", get(n8, "err", null) != null);
  // 顶层 RETURNING (SQLite 3.35+): 单语句原子写。sql_write 排空 RETURNING
  // 行后按 changes 计数。更新侧与插入侧各一条: UPDATE ... RETURNING /
  // INSERT ... SELECT ... RETURNING。注意 CTE 内 DML 的形状(上方负例已拒)
  // 在 SQLite 里根本不存在, 别再用 "WITH u AS (UPDATE ... RETURNING ...)
  // INSERT ..." 表达"更新后按回行插入"——单语句做不到, 分两句即可。
  let dc1 = try(() => {
    sql_write(db, "UPDATE t SET score = ? WHERE name = ? RETURNING name", [8.8, "张三"]);
    return "ok";
  });
  check("update-returning atomic", get(dc1, "err", null) == null);
  let sc = sql_query(db, "SELECT score FROM t WHERE name = '张三' AND score IS NOT NULL");
  check("atomic update visible", len(sc) == 1 && get(sc[0], "score") == 8.8);
  let dc2 = try(() => {
    sql_write(db,
      "INSERT INTO t (name, score) SELECT name, 0.0 FROM t WHERE name = '张三' AND score IS NOT NULL LIMIT 1 RETURNING name");
    return "ok";
  });
  check("insert-returning atomic", get(dc2, "err", null) == null);
  check("atomic insert visible", len(sql_query(db, "SELECT name FROM t WHERE name = '张三'")) == 2);

  // 非 list 参数拒绝
  let badp = try(() => { sql_write(db, "INSERT INTO t (name) VALUES (?)", "x"); return "ok"; });
  check("params must be list", get(badp, "err", null) != null);

  // 缺库文件: READWRITE 打不开 -> 明确报错(不静默新建)
  let missing = try(() => {
    sql_write("/tmp/lume-sqlite-definitely-missing-" + str(now()) + ".db",
              "INSERT INTO x VALUES (1)");
    return "ok";
  });
  check("missing db errors clearly", get(missing, "err", null) != null);

  // ---- 事务 (2026-10-20, P6): 一等句柄 + 原子性 + guardrail ----
  // sql_tx_begin 开 READWRITE|CREATE 连接并 BEGIN; 句柄是 GC 对象, 被回收时
  // 自动 ROLLBACK + close。exec 走 sql_write 同款白名单(独立入口, 不碰
  // sql_write)。错误语义: 失败语句后事务保持 open, 由调用方 commit/rollback。
  // 表结构在事务外建好(sql_write 已提交): 未提交的 CREATE TABLE 对外部连接
  // 是 "no such table"(原子性的一部分), 不能用来验证行不可见。
  let txdb = "/tmp/lume-sqlite-tx-" + str(now()) + ".lume-test.db";
  write_file(txdb, "");
  sql_write(txdb, "CREATE TABLE t (id integer primary key autoincrement, name text)");
  let tx = sql_tx_begin(txdb);
  let tx2 = sql_tx_exec(tx, "INSERT INTO t (name) VALUES (?)", ["tx-one"]);
  check("tx insert", tx2 == 1);
  // 未提交: 外部只读连接不可见 (原子性)
  check("tx uncommitted invisible", len(sql_query(txdb, "SELECT name FROM t")) == 0);
  check("tx commit", sql_tx_commit(tx) == true);
  check("tx committed visible",
    len(sql_query(txdb, "SELECT name FROM t WHERE name = 'tx-one'")) == 1);
  // 已关闭句柄拒绝再执行
  let used = try(() => { sql_tx_exec(tx, "INSERT INTO t (name) VALUES (?)", ["late"]); return "ok"; });
  check("tx exec after commit rejects", get(used, "err", null) != null);

  // rollback 原子性: 回滚后不可见
  let txr = sql_tx_begin(txdb);
  sql_tx_exec(txr, "INSERT INTO t (name) VALUES (?)", ["tx-rolled"]);
  check("tx rollback", sql_tx_rollback(txr) == true);
  check("tx rolled back invisible",
    len(sql_query(txdb, "SELECT name FROM t WHERE name = 'tx-rolled'")) == 0);

  // guardrail: 专用入口走同一写白名单; 失败后事务保持 open (可显式收尾)
  let txs = sql_tx_begin(txdb);
  let bad = try(() => { sql_tx_exec(txs, "DROP TABLE t"); return "ok"; });
  check("tx drop rejects", get(bad, "err", null) != null);
  check("tx stays open after error", sql_tx_rollback(txs) == true);

  // 参数错误: 非句柄（arity 错误已升至编译期, 见 tests/arity-bad/ 回归）
  let notx = try(() => { sql_tx_exec("oops", "SELECT 1"); return "ok"; });
  check("tx exec non-handle rejects", get(notx, "err", null) != null);
  let noarg = try(() => { sql_tx_commit("oops"); return "ok"; });
  check("tx commit non-handle rejects", get(noarg, "err", null) != null);

  // ---- sql_tx_query (2026-11-02, #50): read-your-writes ----
  // sql_query opens a fresh read-only connection per call, so rows written
  // (but not committed) on the transaction's private connection are
  // invisible to it; sql_tx_query reads on the transaction's own connection
  // instead. Same read whitelist as sql_query; errors keep the tx open.
  let txqdb = "/tmp/lume-sqlite-txq-" + str(now()) + ".lume-test.db";
  write_file(txqdb, "");
  sql_write(txqdb, "CREATE TABLE t (id integer primary key autoincrement, name text)");
  let txq = sql_tx_begin(txqdb);
  sql_tx_exec(txq, "INSERT INTO t (name) VALUES (?)", ["ryw"]);
  let inb = sql_tx_query(txq, "SELECT name FROM t");
  check("txq sees uncommitted", len(inb) == 1 and get(inb[0], "name") == "ryw");
  check("txq params bind",
    len(sql_tx_query(txq, "SELECT name FROM t WHERE name = ?", ["ryw"])) == 1);
  check("txq not visible out-of-tx", len(sql_query(txqdb, "SELECT name FROM t")) == 0);
  // read whitelist: a write statement is rejected, tx stays open
  let gq = try(() => { sql_tx_query(txq, "INSERT INTO t (name) VALUES ('x')"); return "ok"; });
  check("txq write guard rejects", get(gq, "err", null) != null);
  check("txq stays open after guard", sql_tx_rollback(txq) == true);
  // closed handle rejects further reads
  let qc = try(() => { sql_tx_query(txq, "SELECT name FROM t"); return "ok"; });
  check("txq after close rejects", get(qc, "err", null) != null);

  return 0;
}
main();
