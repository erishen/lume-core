// Cross-backend consistency fixture — integer core plus struct fields.
//
// The native compiler has two completely independent IR emitters: hand-written
// IR text (--compile-text) and LLVM C API calls (--compile-llvm). Nothing else
// in the suite compares them, so the two drifting apart would surface only as
// a wrong answer somewhere else (this is how "mul i64 %v1, undef" and the
// half-typed struct GEP got in). tests/native_backends.sh compiles and runs
// this script both ways and diffs the outputs.
//
// Deliberately narrow, because the native emitters' covered surface is narrow:
// only integers, floats, an explicit `let` type, struct fields and a function
// signature the source fully annotates *or* fully leaves to inference.
// string concatenation, mixed string/number arithmetic, nested and heterogeneous
// lists and map fields holding lists are still rejected by one backend or the
// other, so adding them here would make the suite red for reasons that have
// nothing to do with the two emitters agreeing.
//
// Adding coverage is fine once a backend actually implements a construct —
// never before, otherwise the consistency suite goes red and hides its signal.

type Point = { x: int, y: int };

func classify(n: int): int {
    if (n > 100) { return 1; }
    if (n > 0) { return 2; }
    if (n == 0) { return 3; }
    return 4;
}

func fib(n: int): int {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

func loop_sum(n: int): int {
    let acc: int = 0;
    for (let i = 0; i < n; i = i + 1) { acc = acc + i; }
    return acc;
}

func while_sum(n: int): int {
    let acc: int = 0;
    let i: int = 0;
    while (i < n) { acc = acc + i * i; i = i + 1; }
    return acc;
}

func sq_dist(a: Point, b: Point): int {
    let dx: int = a.x - b.x;
    let dy: int = a.y - b.y;
    return dx * dx + dy * dy;
}

func make_point(x: int, y: int): Point {
    return { x: x, y: y };
}

func bump(p: Point, d: int): int {
    p.x = p.x + d;
    return p.x;
}

func loop_points(): int {
    let acc: int = 0;
    let i: int = 0;
    while (i < 3) {
        let q: Point = { x: i, y: i + 1 };
        acc = acc + q.x + q.y;
        i = i + 1;
    }
    return acc;
}

func main(): int {
    print(classify(170));
    print(classify(1));
    print(classify(0));
    print(classify(-5));
    print(fib(12));
    print(loop_sum(10));
    print(while_sum(6));
    print(sq_dist({ x: 3, y: 4 }, { x: 0, y: 0 }));
    print(sq_dist({ x: 3, y: 4 }, make_point(1, 1)));
    print(make_point(7, 8).x);
    print({ x: 5, y: 9 }.y);
    let p: Point = { x: 3, y: 4 };
    p.x = 10;
    print(p.x);
    print(p.y);
    print(bump(p, 5));
    print(p.x);
    print(loop_points());
    return 0;
}

// A top-level statement: the entry point has to run the module's own statements
// before main(), which is a shape worth keeping under the consistency net
// because it took a segfault to find out.
func warmup() {
    print(classify(170));
}

// ---- list / map / for-in ----
//
// Added only once both emitters implemented them: in native code a list and a
// map are heap objects behind an opaque pointer, and a backend that passes the
// variable's *slot* instead of loading the pointer reads its length out of the
// stack frame. That failure is silent in exactly one leg, which is the drift
// this script exists to catch.
let xs = [1, 2, 3];
print(xs);
print(len(xs));
print(xs.len);
print(xs.length);
print([]);
print(["a", "b"]);
print([1.5, 2.0]);
for (x in xs) { print(x); }

let ys = [1];
print(push(ys, 7));
print(ys.len);

let m = {"a": 1, "b": 2};
print(m);
print(m.len);
print(get(m, "a"));
print(get(m, "zz", 9));
print(put(m, "c", 3));
print(keys(m));
for (k in m) { print(k); }
print({});

// and/or short-circuit: the right operand must not be evaluated at all, and
// the result must be the constant on the short path (`true or 1/0` is true
// even though the division never runs).
let d: int = 0;
print(d != 0 and 10 / d > 1);
print(d == 0 or 10 / d > 1);

// `/` is float division even on two integers. A native `sdiv` answers 2 for
// `10 / 4` where the interpreter answers 2.5 — a wrong answer rather than an
// error, so it has to be under the consistency net too, not just the
// short-circuit above that never evaluates the division.
print(10 / 4);
print(10 / 4.0);
print(10 % 4);

// Strings: concatenation and `.len`. Both used to be unimplemented on the
// libLLVM side only — the same script compiled with --compile-text and failed
// to compile at all with --compile-llvm, because `s.len` fell through the
// member emitter's `.len` branches and print() got a value it could not name.
print("ab" + "cd");
let s = "hello";
print(s.len);
print(s.length);

// float arithmetic, the other half of the core subset.
let a: float = 1.5;
let b: float = 2.0;
print(a + b);
print(a * b);
print(a - b);

// `continue` used to jump back to the *condition* block, which is where a
// loop re-tests but not where it advances: the index never moved and any
// loop containing a `continue` spun forever (both emitters, both loop
// shapes). It now lands on the increment block, which branches to the
// condition; `while` has no increment so its target stays the condition.
for (let i = 0; i < 5; i = i + 1) {
    if (i == 1) { continue; }
    if (i == 4) { break; }
    print(i);
}

let xi = [1, 2, 3, 4];
for (e in xi) {
    if (e == 2) { continue; }
    if (e == 4) { break; }
    print(e);
}

// A named struct whose *field* holds a list. The field is a heap object
// behind an opaque pointer, so this also covers the struct GEP path for
// something that is not a scalar.
type Bag = { xs: int[] };
let bag: Bag = { xs: [4, 5] };
print(bag.xs);
print(bag.xs.len);
for (v in bag.xs) { print(v); }

// ---- function signatures left to inference --------------------------------
// One signature pass runs over the AST before either emitter, so an
// unannotated parameter and an unannotated return type are resolved the same
// way in both. The order matters: `v` is pinned by the first call, and
// `inner`'s parameter is only knowable from a call made inside `outer`'s body,
// which is what the fixed-point iteration is for.
func dbl(v) { return v * 2; }
print(dbl(21));

func halve(v) { return v / 2; }        /* `/` widens to float, so 9 / 2 = 4.5 */
print(halve(9));

// ---- int is i64, not a double (docs/SPEC.md§integers) -------------------
//
// These pin the property that the interpreter and the two native backends used
// to disagree on: `int` was stored in a C double, so anything past 2^53 was
// silently rounded and int overflow saturated in the interpreter while the
// backends wrapped in i64. Every line below is chosen to fail loudly on either
// half of that split.

/* Literals past 2^53 must survive lexing exactly. 2^53+1 is the smallest
 * integer a double cannot represent, so it is the smallest witness. */
print(9007199254740993);
print(123456789012345678);

/* Both i64 extremes. */
print(9223372036854775807);
print(-9223372036854775808);

/* Wrapping, matching the emitters' unadorned `add i64` / `mul i64`. */
let big = 9223372036854775807;
print(big + 1);
print(big * 2);
print(0 - big - 1);

/* int modulo keeps C's sign convention and never detours through fmod, which
 * would round a large int; `/` stays floating point even for two ints.
 *
 * The unary-minus-then-modulo case (`let neg = -7; neg % 3`) lives in the smoke
 * suite rather than here: the libLLVM backend cannot yet type a variable
 * initialised from a unary minus (docs/SPEC.md §6.1), so putting it in this
 * three-way target would fail the target for a known, unrelated reason. */
print(-7 / 2);
print(-7 % 3);
print(7 % -3);

/* An int compared against a float is a well-typed comparison, and comparing
 * them must not go through a lossy widening on the way to str(). */
print(1 == 1.0);
print(2.5 + 1);
print(3 / 2);

// ---- loops (docs/SPEC.md §4) --------------------------------------------
//
// Pinned here so a backend cannot drift on loop-variable scope, break/continue,
// or while's strict-boolean condition.
//
// Both §4 behaviours below used to be native-only failures, now fixed:
//   * two bindings sharing one name in the same function -- the IR text backend
//     used to name every local `%lv_<name>`, so they collided and it refused to
//     assemble. They now get distinct slots (`%lv_<name>_<uid>`).
//   * mutating the iterated list with `push` -- both native backends used to
//     re-read the length every iteration and loop forever (OOM, exit 137). The
//     length is now snapshotted at loop entry, matching the interpreter.
// The loop variable still leaks past the loop (printed below), which is the
// documented non-block-scoped behaviour, not a bug.
for (let loopvar in [1, 2]) { }
print(loopvar);                 // the loop variable outlives the loop
for (let contvar in [1, 2, 3]) { if (contvar == 2) { continue; } print(contvar); }
for (let brkvar in [1, 2, 3]) { if (brkvar == 2) { break; } print(brkvar); }
let whilevar = 0;
while (whilevar < 3) { print(whilevar); whilevar = whilevar + 1; }
for (let mapkey in { a: 7 }) { print(mapkey); }   // for-in over a map walks keys

// ---- same-name loop variables (bug #1 fixed) ----------------------------
//
// Two `for (a in ...)` in one function used to collide in the text backend's
// `%lv_<name>` slots: a for variable leaks past the loop into the function
// scope, so two loops reusing the name landed on one `%lv_a` and the module
// failed to assemble. They now get distinct slots (`%lv_a_<uid>`), so the two
// loops run independently. Both the sequential and the nested shape below used
// to break codegen; the three backends must agree on each.
func seq_same() {
    for (a in [1, 2]) { print(a); }
    for (a in [3, 4]) { print(a); }
}
seq_same();             // 1 2 3 4

func nest_same() {
    for (a in [1, 2]) {
        for (a in [3, 4]) { print(a); }
    }
}
nest_same();            // 3 4 3 4 (inner runs for each outer iteration)

// ---- push inside for-in (bug #2 fixed) ----------------------------------
//
// `push` inside the body used to grow the iteration bound forever and OOM the
// native backends. The length is snapshotted at loop entry, so only the
// original three elements are visited and the final list holds six.
let pt = [1, 2, 3];
for (p in pt) {
    push(pt, p * 10);
}
print(len(pt));         // 6
print(pt);              // [1,2,3,10,20,30]

func sum3(a, b, c) { return a + b + c; }
print(sum3(1, 2, 3));

func pick(c) { if (c) { return 1; } return 2; }
print(pick(true));
print(pick(false));

func outer(x) { return inner(x) + 1; }
func inner(x) { return x * 3; }
print(outer(4));

/* An int handed back through a float slot: the return has to widen it, or the
 * IR reads `ret double %t0` for an i64 register. */
func as_float(v: int): float { return v; }
print(as_float(7));

// ---- `.len` on a named struct reads the declared field --------------------
//
// Both emitters resolve `.len` from the struct's field table and never from a
// key count, so the interpreter has to read it the same way once a map literal
// is bound to a named type. The field value (7) deliberately differs from the
// member count (2), so an interpreter that counts members cannot hide here.
// The anonymous-map half of the rule — `.len` *is* the key count there — is
// pinned in the smoke suite instead; the emitters' map support is narrower.
type Sized = { len: int, w: int };
let sized: Sized = { len: 7, w: 2 };
print(sized.len);
print(sized.w);

// §8.1 #2: a `let` bound to a unary or binary expression must infer a type in
// the native backends too. Before the fix the libLLVM backend reported
// "cannot infer a type for 'neg'" / "print() cannot print this value" while
// the interpreter accepted it; all three now agree.
let neg = -7;
print(neg);            // -7
let diff = 0 - 7;
print(diff);           // -7

// §8.1 #3 (native-backend gap): `null` literals and printing them must work
// in the native backends too. Before the fix both emitters reported "cannot
// infer a type for 'x'" / "null literals are not supported by the native
// backend yet" while the interpreter accepted `null` and printed "null"; all
// three now agree.
let n = null;
print(n);              // null
print(null);           // null

// §8.1 #6: a Result value must survive a round trip through both native
// backends. Before the fix neither emitter had a codegen type for Result at
// all -- llvm_type_of() returned NULL, so even `let r = divide(21, 7);`
// with no `?` anywhere reported "variable 'r' has no codegen type" while the
// interpreter ran it. Result is `{ ok: ... }` / `{ err: ... }`, which the
// interpreter treats as an ordinary map, so natively it is the same heap map.
//
// The `?` propagation operator is still unsupported by both emitters (it needs
// the payload type, which typecheck_expr.c has as any_type() -- no generics);
// the typechecker already rejects `?` on a non-Result callee, so nothing here
// can drift into using it.
func divide(a: int, b: int): Result {
  if (b == 0) { return { err: "division by zero" }; }
  return { ok: a / b };
}
func show(): Result {
  let good = divide(21, 7);
  print(good);                         // {"ok":3}
  let bad = divide(21, 0);
  print(bad);                          // {"err":"division by zero"}
  return { ok: 1 };
}
print(show());           // {"ok":1}

// Native-backend containers can nest. Before this, every slot in rt.c held a
// scalar, so both emitters refused anything like the two lines below with
// "map values must be int, float or string" / "list elements must be ..." while
// the interpreter has always accepted them. The depth here is deliberate: the
// native printer used to render a slot through one fixed 1024-byte buffer, so a
// recursive shape is exactly what would have exposed it -- these four levels and
// the mixed list-in-map-in-list below are what pin the streaming version.
print({ a: { b: { c: { d: 1 } } } });          // {"a":{"b":{"c":{"d":1}}}}
print([[1, [2, 3]], [4]]);                     // [[1,[2,3]],[4]]
print({ x: [1, { y: "s" }] });                 // {"x":[1,{"y":"s"}]}
print([[]]);                                  // [[]]
print([{ a: 1 }, { b: 2 }]);                  // [{"a":1},{"b":2}]
print({ a: [1.5, 2.5] });                     // {"a":[1.5,2.5]}
// Reading a nested value back out needs the pointer-returning getter, which is
// picked from the *default*'s type -- a container default is what tells the
// emitter the key holds a container rather than an int.
let nested = { a: { b: 1 } };
print(get(nested, "a", { z: 0 }));            // {"b":1}

// ---- index syntax `m["k"]` / `l[0]` (docs/SPEC.md §6.2) -----------------
//
// Both native backends now lower index syntax. List indexing is fully typed
// (the element type is statically known), so the result prints directly and
// the three backends agree byte-for-byte. Map reads return an opaque i8* the
// emitter cannot type (map value types are not tracked), so the portable use
// is to bind the result to a typed variable -- which is what the lines below
// do, and what all three backends accept and print the same way.
let il = [10, 20, 30];
print(il[0]);            // 10
print(il[2]);            // 30
print(il[-1]);           // 30
let is = ["p", "q", "r"];
print(is[1]);            // q
let im = { name: "lume", nums: [1, 2, 3] };
let iname: string = im["name"];
print(iname);            // lume
let inums: int[] = im["nums"];
print(inums[0]);         // 1
print(inums[2]);         // 3
let ikey = "name";
let ikeyed: string = im[ikey];
print(ikeyed);           // lume

// ---- closures as first-class values (docs/SPEC.md §4.8) ------------------
//
// No-capture lambdas are now first-class on all three backends: they box
// into an opaque closure record (fn pointer + null context) at the literal
// site, can be stored in a variable, called, and handed to the native
// map/filter/reduce loops. Everything below must print byte-identically
// from the interpreter, the text emitter and the libLLVM emitter -- this
// section is what retired §4.8's "closures are interpreter-only" stance.

let f = (x) => x * 2;
print(f(3));                                   // 6
print(f(10));                                  // 20
let sq = (x) => x * x;
print(sq(7));                                  // 49

// Inline lambdas straight into the higher-order builtins. The loop reads
// elements through the same accessor table for-in uses and snapshots the
// length once, so all three backends iterate the exact same count.
print(map((x) => x * x, [1, 2, 3]));           // [1,4,9]
print(filter((x) => x > 1, [1, 2, 3]));        // [2,3]
print(reduce((a, x) => a + x, [1, 2, 3], 0));  // 6

// A closure VARIABLE as a HOF argument -- the value travels through the
// same boxing path whether it is called directly or consumed by a loop.
let twice = (x) => x + x;
print(map(twice, [1, 2, 3]));                  // [2,4,6]

// String elements and a non-zero reduce seed (the seed type pins the
// accumulator slot; 10 must survive to the result, not start at 0).
print(map((s) => s, ["a", "b"]));              // ["a","b"]
print(reduce((a, x) => a + x, [1, 2], 10));    // 13

// Zero-argument lambdas (the record's fn type has just the context slot).
let seven = () => 7;
print(seven());                                // 7

// A bool-returning filter predicate (truthy test reads the register as-is)
// and float element/accumulator shapes (at/push dispatch on the element).
print(filter((x) => x % 2 == 0, [1, 2, 3, 4]));         // [2,4]
print(map((x) => x * 1.5, [1, 2, 3]));                  // [1.5,3,4.5]
print(reduce((a, x) => a + x, [1, 2, 3], 0.5));         // 6.5

// An annotated empty list gives the HOF loops their element type; the bare
// `[]` literal does not and is refused (SPEC §8.1 #11).
let ez: int[] = [];
print(map((x) => x * 2, ez));                   // []
print(reduce((a, x) => a + x, ez, 100));        // 100

// --- locals lookup is position-aware (SPEC 8.1 #12) ---
// The pre-scanned locals table can hold several same-name bindings; a use
// site sees the latest one declared at or above its own line. Sibling-block
// bindings of one name with divergent types used to funnel into the last
// entry's slot and hand the first print an uninitialized i8*.
func sz(): string {
  if (1 == 1) { let t = 1; print(t); }
  if (1 == 1) { let t = "two"; print(t); }
  return "ok";
}
print(sz());                                    // 1 two ok

// A for-in variable rebinding an existing name keeps the rebound value and
// type after the loop (the interpreter's set-or-define semantics).
let w2 = 99;
for (w2 in [7, 8]) { print(w2); }               // 7 8
print(w2);                                      // 8

// ---- top-level bindings are visible inside function bodies (SPEC 8.1 #10)
//
// Every top-level `let` is one module slot that the top level's stores and
// the function bodies' loads share: a function reads whatever the top level
// last stored before the call (call-time env lookup, not a snapshot), an
// assignment inside a body defines a fresh function local that never
// reaches the top level, and a parameter shadows the global.
let gbase = 1;
func readg(): int { return gbase; }
print(readg());                                 // 1
gbase = 2;                                      // top-level mutation...
print(readg());                                 // ...seen at call time: 2
func touchg() { gbase = 5; }                    // defines a LOCAL, not the global
touchg();
print(gbase);                                   // 2 (untouched by touchg)

let base = 10;
func addbase(x: int): int { return x + base; }
print(addbase(5));                              // 15

let greet = "hi";
func shout(): string { return greet + "!"; }
print(shout());                                 // hi!

let shad = 7;
func shadow2(shad: int): int { return shad * 2; }
print(shadow2(3));                              // 6 (parameter shadows)

warmup();
main();
