// ode-consistency.lume — sci.lume ODE（向量系统 / 自适应步长 / 隐式刚性方法 /
// 辛积分 / 线性多步法）三后端一致性测试。由 tests/ode_backends.sh 驱动：
// 解释器 / 文本 IR / LLVM 输出须逐字节一致。
import "../lib/sci.lume" as sci;

// ── 谐波振荡器：y' = [y1, -y0]，y0=[1,0] → y(t)=[cos t, -sin t] ──
// t = π/2 处端点应 ≈ [0, -1]
let traj = sci.rk4_sys((t: float, y: float[]) => [y[1], -y[0]], [1.0, 0.0], 0.0, 1.57079632679, 200);
print(traj[len(traj) - 1]);

// ── 线性系统 y' = A·y，A=[[-1,0],[0,-2]]，y0=[1,1] → [e^{-t}, e^{-2t}] ──
// t=1 处端点应 ≈ [0.367879, 0.135335]
let A: float[][] = [[-1.0, 0.0], [0.0, -2.0]];
let traj2 = sci.rk4_sys_linear(A, [1.0, 1.0], 0.0, 1.0, 200);
print(traj2[len(traj2) - 1]);

// ── 一致性：1D 标量情形 rk4_sys 应退化为 rk4 ──
let s1 = sci.rk4((t: float, y: float) => -2.0 * y, 1.0, 0.0, 1.0, 50)[50];
let s2t = sci.rk4_sys((t: float, y: float[]) => [-2.0 * y[0]], [1.0], 0.0, 1.0, 50);
let s2 = s2t[len(s2t) - 1][0];
print(s1 - s2);

// ── 自适应步长 RK4：误差控制（tol 越紧 → 步数越多、误差越小）──
// y' = -2y，y0=1，t∈[0,1]，解析 y(1) = e^{-2}
let ex2 = exp(-2.0);
let ra = sci.rk4_adaptive((t: float, y: float) => -2.0 * y, 1.0, 0.0, 1.0, 1e-4, 0.1);
let rb = sci.rk4_adaptive((t: float, y: float) => -2.0 * y, 1.0, 0.0, 1.0, 1e-8, 0.1);
print(len(ra));                       // 宽松 tol → 步数少
print(len(rb));                       // 严格 tol → 步数多
print(ra[len(ra) - 1][1] - ex2);     // 误差（较大）
print(rb[len(rb) - 1][1] - ex2);     // 误差（远小于上一行）
print(ra[len(ra) - 1][0]);           // 终点 t 应精确 = 1

// ── 自适应步长 RK4：陡峭解 y' = -20y 的步长自动调节 ──
// 初期变化剧烈需小步长，后期平缓可放大步长。
let rc = sci.rk4_adaptive((t: float, y: float) => -20.0 * y, 1.0, 0.0, 1.0, 1e-6, 0.1);
print(rc[len(rc) - 1][1] - exp(-20.0));                    // 终点误差
print(rc[1][0] - rc[0][0]);                                // 首步长（小）
print(rc[len(rc) - 1][0] - rc[len(rc) - 2][0]);            // 末步长（显著变大）
print(len(rc));

// ── 隐式 θ-方法：非刚性 y' = −y 的收敛阶 ──
// 后向 Euler 精确解 (1+h)^{-n}（一阶）；梯形精确解 ((1−h/2)/(1+h/2))^n（二阶）。
// 步长减半（n: 10 → 20）时误差应分别 ≈1/2、≈1/4。解析 y(1) = e⁻¹。
let imp_ex1 = exp(-1.0);
let imp_ie10 = sci.ode_imp_euler((t: float, y: float) => -y, 1.0, 0.0, 1.0, 10)[10];
let imp_ie20 = sci.ode_imp_euler((t: float, y: float) => -y, 1.0, 0.0, 1.0, 20)[20];
let imp_tr10 = sci.ode_trapezoid((t: float, y: float) => -y, 1.0, 0.0, 1.0, 10)[10];
let imp_tr20 = sci.ode_trapezoid((t: float, y: float) => -y, 1.0, 0.0, 1.0, 20)[20];
print(imp_ie10 - imp_ex1);                     // 后向 Euler 一阶误差
print(imp_ie20 - imp_ex1);                     // ≈上一行 /2
print((imp_ie10 - imp_ex1) / (imp_ie20 - imp_ex1));   // ≈2（一阶收敛）
print(imp_tr10 - imp_ex1);                     // 梯形二阶误差（小得多）
print(imp_tr20 - imp_ex1);                     // ≈上一行 /4
print((imp_tr10 - imp_ex1) / (imp_tr20 - imp_ex1));   // ≈4（二阶收敛）

// θ=0 端点退化为显式 Euler：(1−h)^n = 0.9^10
let imp_ee = sci.ode_theta((t: float, y: float) => -y, 1.0, 0.0, 1.0, 10, 0.0)[10];
print(imp_ee - pow(0.9, 10.0));               // ≈0

// ── 刚性方程：y' = −1000(y − cos t) − sin t，解析 y(t) = cos t ──
// 显式 RK4 稳定要求 h ≲ 2.8/1000 = 0.0028（n ≳ 357）；这里 h = 0.1（n=10）
// 远超显式稳定域，A-稳定隐式法仍应稳定推进。
let imp_sie = sci.ode_imp_euler((t: float, y: float) => -1000.0 * (y - cos(t)) - sin(t),
                                1.0, 0.0, 1.0, 10);
let imp_str = sci.ode_trapezoid((t: float, y: float) => -1000.0 * (y - cos(t)) - sin(t),
                                1.0, 0.0, 1.0, 10);
print(imp_sie[10]);
print(imp_str[10]);
print(cos(1.0));
print(imp_sie[10] - cos(1.0));                 // 后向 Euler 误差
print(imp_str[10] - cos(1.0));                 // 梯形误差（应更小）

// 显式 RK4 同一步长失效；把 |y(1)| 截断到 1e6，避免超大数在三后端格式漂移
let imp_srk = sci.rk4((t: float, y: float) => -1000.0 * (y - cos(t)) - sin(t),
                      1.0, 0.0, 1.0, 10);
let imp_srkm: float = abs(imp_srk[10]);
if (imp_srkm > 1e6) { imp_srkm = 1e6; }
print(imp_srkm);                               // 1e6（显式发散被截断）

// ── 辛积分 Velocity Verlet：谐振子长期能量守恒 ──
// H = p²/2 + q²/2，q0=1、p0=0 → q(t)=cos t、p(t)=−sin t，E ≡ 0.5。
// h=0.2、n=5000 → t=1000（约 159 个周期）。
let sym_h = 0.2;
let sym_n = 5000;
let sym_vtraj = sci.verlet((q: float) => -q, 1.0, 0.0, 1.0, sym_h, sym_n);
let sym_rtraj = sci.rk4_sys((t: float, y: float[]) => [y[1], -y[0]],
                            [1.0, 0.0], 0.0, sym_h * (sym_n * 1.0), sym_n);

// 短期相位精度（t=10，k=50）：Verlet 二阶有 O(h²) 误差，RK4 四阶近乎精确
print(sym_vtraj[50][0] - cos(10.0));
print(sym_vtraj[50][1] + sin(10.0));
print(sym_rtraj[50][0] - cos(10.0));

// 长期能量：E = (p²+q²)/2。Verlet 由后向误差分析守恒 H̃=H+O(h²)，
// 能量误差在 ±h²/8 带内**有界振荡**；RK4 虽四阶、短期更准，能量却
// 单调耗散（误差 ∝ t），外推 t≈2200 即超出 Verlet 的有界带——这正是
// 长期定性积分要用辛格式的理由。
let sym_ve0 = 0.5 * (sym_vtraj[0][0] * sym_vtraj[0][0] + sym_vtraj[0][1] * sym_vtraj[0][1]);
let sym_ve500 = 0.5 * (sym_vtraj[2500][0] * sym_vtraj[2500][0] + sym_vtraj[2500][1] * sym_vtraj[2500][1]);
let sym_ve1000 = 0.5 * (sym_vtraj[5000][0] * sym_vtraj[5000][0] + sym_vtraj[5000][1] * sym_vtraj[5000][1]);
let sym_re500 = 0.5 * (sym_rtraj[2500][0] * sym_rtraj[2500][0] + sym_rtraj[2500][1] * sym_rtraj[2500][1]);
let sym_re1000 = 0.5 * (sym_rtraj[5000][0] * sym_rtraj[5000][0] + sym_rtraj[5000][1] * sym_rtraj[5000][1]);
print(sym_ve500 - sym_ve0);              // Verlet t=500：落在有界带内
print(sym_ve1000 - sym_ve0);             // Verlet t=1000：仍在同一带内，不放大
print(sym_re500 - 0.5);                  // RK4 t=500：已耗散
print(sym_re1000 - 0.5);                 // RK4 t=1000：约为上一行 2 倍
print(sym_ve1000 - sym_ve500);           // Verlet 两时刻之差：振荡，非累积
print(sym_re1000 - sym_re500);           // RK4 两时刻之差：单调漂移（∝ Δt）

// ── 非线性单摆：辛格式对一般势能同样保持能量有界 ──
// H = p²/2 + (1 − cos q)，F(q) = −sin q，q0=1、p0=0 → E0 = 1 − cos 1
let sym_ptraj = sci.verlet((q: float) => -sin(q), 1.0, 0.0, 1.0, sym_h, sym_n);
let sym_pe0 = 0.5 * sym_ptraj[0][1] * sym_ptraj[0][1] + 1.0 - cos(sym_ptraj[0][0]);
let sym_pe1000 = 0.5 * sym_ptraj[5000][1] * sym_ptraj[5000][1] + 1.0 - cos(sym_ptraj[5000][0]);
print(sym_pe1000 - sym_pe0);             // O(h²) 有界，159 个周期后不漂移

// ════════════════════════════════════════════════════════════════
// 线性多步法：Adams–Bashforth 显式族 AB1..AB4 + 隐式 BDF2
// y' = −y，y0=1，t∈[0,1]，解析 y(1) = e⁻¹。n 加倍时 p 阶方法误差应 ÷2^p。
// ════════════════════════════════════════════════════════════════
print(sci.SCI_VERSION);                  // 0.6.0
let ms_ex = exp(-1.0);

let ms_a1_20 = sci.adams_bashforth((t: float, y: float) => -y, 1.0, 0.0, 1.0, 20, 1)[20] - ms_ex;
let ms_a1_40 = sci.adams_bashforth((t: float, y: float) => -y, 1.0, 0.0, 1.0, 40, 1)[40] - ms_ex;
let ms_a1_80 = sci.adams_bashforth((t: float, y: float) => -y, 1.0, 0.0, 1.0, 80, 1)[80] - ms_ex;
print(ms_a1_20); print(ms_a1_40);
print(ms_a1_20 / ms_a1_40);              // ≈2（AB1 一阶）
print(ms_a1_40 / ms_a1_80);              // ≈2

let ms_a2_20 = sci.ab2((t: float, y: float) => -y, 1.0, 0.0, 1.0, 20)[20] - ms_ex;
let ms_a2_40 = sci.ab2((t: float, y: float) => -y, 1.0, 0.0, 1.0, 40)[40] - ms_ex;
let ms_a2_80 = sci.ab2((t: float, y: float) => -y, 1.0, 0.0, 1.0, 80)[80] - ms_ex;
print(ms_a2_20); print(ms_a2_40);
print(ms_a2_20 / ms_a2_40);              // ≈4（AB2 二阶）
print(ms_a2_40 / ms_a2_80);              // ≈4

let ms_a3_20 = sci.ab3((t: float, y: float) => -y, 1.0, 0.0, 1.0, 20)[20] - ms_ex;
let ms_a3_40 = sci.ab3((t: float, y: float) => -y, 1.0, 0.0, 1.0, 40)[40] - ms_ex;
let ms_a3_80 = sci.ab3((t: float, y: float) => -y, 1.0, 0.0, 1.0, 80)[80] - ms_ex;
print(ms_a3_20); print(ms_a3_40);
print(ms_a3_20 / ms_a3_40);              // ≈8（AB3 三阶）
print(ms_a3_40 / ms_a3_80);              // ≈8

let ms_a4_20 = sci.ab4((t: float, y: float) => -y, 1.0, 0.0, 1.0, 20)[20] - ms_ex;
let ms_a4_40 = sci.ab4((t: float, y: float) => -y, 1.0, 0.0, 1.0, 40)[40] - ms_ex;
let ms_a4_80 = sci.ab4((t: float, y: float) => -y, 1.0, 0.0, 1.0, 80)[80] - ms_ex;
print(ms_a4_20); print(ms_a4_40);
print(ms_a4_20 / ms_a4_40);              // ≈16（AB4 四阶，启动段误差使其略小）
print(ms_a4_40 / ms_a4_80);              // ≈16

// 同阶不同精度：AB4 稳态每步 1 次 f、RK4 每步 4 次 f。
// 同一 h 下 RK4 误差更小（此处约 37 倍），故 AB 族的优势是右端项昂贵时
// 用更多步数换精度，而非同等步数下更准。
let ms_rk_20 = sci.rk4((t: float, y: float) => -y, 1.0, 0.0, 1.0, 20)[20] - ms_ex;
print(ms_rk_20);
print(ms_a4_20 / ms_rk_20);

// 端点契约：AB1 应严格退化为显式 Euler (1−h)^n；order 越界钳制到 [1,4]；
// n 小于启动步数时全部由 rk4 启动值覆盖；n=0 返回单点（不除零）。
let ms_euler = sci.adams_bashforth((t: float, y: float) => -y, 1.0, 0.0, 1.0, 10, 1)[10];
print(ms_euler - pow(0.9, 10.0));        // ≈0
print(sci.adams_bashforth((t: float, y: float) => -y, 1.0, 0.0, 1.0, 10, 9)[10]
      - sci.ab4((t: float, y: float) => -y, 1.0, 0.0, 1.0, 10)[10]);   // 钳制到 AB4
print(sci.ab4((t: float, y: float) => -y, 1.0, 0.0, 1.0, 2)[2]);       // 全是启动值
print(len(sci.ab4((t: float, y: float) => -y, 1.0, 0.0, 1.0, 0)));     // 1

// ── BDF2：非刚性方程二阶收敛 ──
let ms_b_20 = sci.bdf2((t: float, y: float) => -y, 1.0, 0.0, 1.0, 20)[20] - ms_ex;
let ms_b_40 = sci.bdf2((t: float, y: float) => -y, 1.0, 0.0, 1.0, 40)[40] - ms_ex;
let ms_b_80 = sci.bdf2((t: float, y: float) => -y, 1.0, 0.0, 1.0, 80)[80] - ms_ex;
print(ms_b_20); print(ms_b_40);
print(ms_b_20 / ms_b_40);                // ≈4（BDF2 二阶）
print(ms_b_40 / ms_b_80);                // ≈4
print(sci.bdf2((t: float, y: float) => -y, 1.0, 0.0, 1.0, 0)[0]);

// ── 刚性方程 y' = −1000(y − cos t) − sin t，解析 y(t) = cos t ──
// 初值恰在慢流形上，h=0.1 远超显式稳定域；A-稳定 BDF2 仍稳定且二阶收敛。
let ms_s10 = sci.bdf2((t: float, y: float) => -1000.0 * (y - cos(t)) - sin(t),
                      1.0, 0.0, 1.0, 10);
let ms_s20 = sci.bdf2((t: float, y: float) => -1000.0 * (y - cos(t)) - sin(t),
                      1.0, 0.0, 1.0, 20);
print(ms_s10[10]);
print(ms_s10[10] - cos(1.0));            // h=0.1 误差 O(h²)
print(ms_s20[20] - cos(1.0));            // h=0.05 误差约为上一行 /4
print((ms_s10[10] - cos(1.0)) / (ms_s20[20] - cos(1.0)));
let ms_sa = sci.ab4((t: float, y: float) => -1000.0 * (y - cos(t)) - sin(t),
                    1.0, 0.0, 1.0, 10);
let ms_sam: float = abs(ms_sa[10]);
if (ms_sam > 1e6) { ms_sam = 1e6; }
print(ms_sam);                           // 显式 AB4 发散，截断到 1e6

// ── 刚性瞬变衰减：y' = −1000y，y0=1，解析 y(t) = e^{−1000t} ──
// 初值偏离慢流形。A-稳定但不 L-稳定的梯形法留下 (−1)^n 振荡（t=1 仍 ≈0.67），
// BDF2 的强阻尼把瞬变迅速压到 0。
let ms_d = sci.bdf2((t: float, y: float) => -1000.0 * y, 1.0, 0.0, 1.0, 10);
let ms_dt = sci.ode_trapezoid((t: float, y: float) => -1000.0 * y, 1.0, 0.0, 1.0, 10);
print(ms_d[1]);                          // 启动步：梯形法产生反号瞬变
print(ms_d[2]);                          // BDF2 第 2 步已衰减约 40 倍
print(ms_d[10]);                         // t=1：≈0
print(ms_dt[10]);                        // 梯形法残留振荡
