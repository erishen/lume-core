// dist-consistency.lume — 连续概率分布库三后端一致性套件
// （解释器 / 文本 IR / LLVM）输出逐字节一致。
// 运行：tests/dist_backends.sh
//
// 覆盖：uniform / normal / exponential / gamma / beta / chi-square /
//       student-t / lognormal 的 PDF / CDF / PPF，以及 PPF↔CDF 往返一致性。
// 注：PPF 为迭代/解析反解，输出为浮点值；三后端因执行同一份 AST（浮点
// 运算顺序由 lume 显式控制）必然逐字节一致，与具体精度无关。

import "../lib/dist.lume" as dist;

// ── 标准正态（解析校验点）────────────────────────────────────
print(dist.dist_normal_pdf(0.0, 0.0, 1.0));     // ≈ 0.398942
print(dist.dist_normal_cdf(0.0, 0.0, 1.0));      // 0.5
print(dist.dist_normal_cdf(1.959964, 0.0, 1.0)); // ≈ 0.975
print(dist.dist_normal_ppf(0.5, 0.0, 1.0));      // 0.0
print(dist.dist_normal_ppf(0.975, 0.0, 1.0));    // ≈ 1.959964
// 往返：cdf(ppf(q)) ≈ q
print(dist.dist_normal_cdf(dist.dist_normal_ppf(0.9, 2.0, 3.0), 2.0, 3.0)); // ≈ 0.9

// ── 均匀 ─────────────────────────────────────────────────────
print(dist.dist_uniform_pdf(0.5, 0.0, 1.0));    // 1.0
print(dist.dist_uniform_cdf(0.5, 0.0, 1.0));    // 0.5
print(dist.dist_uniform_ppf(0.5, 0.0, 1.0));    // 0.5

// ── 指数（λ=2）──────────────────────────────────────────────
print(dist.dist_exponential_pdf(0.5, 2.0));     // 2*e^-1 ≈ 0.735759
print(dist.dist_exponential_cdf(0.5, 2.0));     // 1-e^-1 ≈ 0.632121
print(dist.dist_exponential_ppf(0.6321206, 2.0)); // ≈ 0.5

// ── Gamma（shape=2, scale=2）─────────────────────────────────
print(dist.dist_gamma_pdf(2.0, 2.0, 2.0));      // 2*e^-1/4 ≈ 0.18394
print(dist.dist_gamma_cdf(4.0, 2.0, 2.0));      // igamma(2,2) ≈ 0.593994
print(dist.dist_gamma_cdf(dist.dist_gamma_ppf(0.75, 2.0, 2.0), 2.0, 2.0)); // ≈ 0.75

// ── Beta（a=2, b=3）──────────────────────────────────────────
print(dist.dist_beta_pdf(0.4, 2.0, 3.0));       // 0.4*0.6^2/B(2,3)=0.4*0.36/0.08333 ≈ 1.728
print(dist.dist_beta_cdf(0.4, 2.0, 3.0));       // ibeta(2,3,0.4) ≈ 0.5248
print(dist.dist_beta_cdf(dist.dist_beta_ppf(0.5, 2.0, 3.0), 2.0, 3.0));    // ≈ 0.5

// ── 卡方（df=3）──────────────────────────────────────────────
print(dist.dist_chisq_pdf(2.0, 3.0));           // gamma(1.5,2) at 2 ≈ 0.176032
print(dist.dist_chisq_cdf(2.0, 3.0));           // chisq_cdf(2,3) ≈ 0.41588
print(dist.dist_chisq_cdf(dist.dist_chisq_ppf(0.9, 3.0), 3.0));            // ≈ 0.9

// ── Student-t（df=5）─────────────────────────────────────────
print(dist.dist_student_t_pdf(0.0, 5.0));       // Γ3/Γ2.5/(sqrt(5π)*(1)^-3) ≈ 0.379607
print(dist.dist_student_t_cdf(0.0, 5.0));       // 0.5
print(dist.dist_student_t_cdf(2.015, 5.0));     // ≈ 0.95
print(dist.dist_student_t_cdf(dist.dist_student_t_ppf(0.95, 5.0), 5.0));   // ≈ 0.95

// ── 对数正态（μ=0, σ=1）─────────────────────────────────────
print(dist.dist_lognormal_pdf(1.0, 0.0, 1.0));  // 1/(1*1*sqrt(2π)) ≈ 0.398942
print(dist.dist_lognormal_cdf(1.0, 0.0, 1.0));  // normcdf(0)=0.5
print(dist.dist_lognormal_cdf(dist.dist_lognormal_ppf(0.8, 0.0, 1.0), 0.0, 1.0)); // ≈ 0.8
