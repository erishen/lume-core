// pde-consistency.lume — 偏微分方程数值解库三后端一致性套件
// （解释器 / 文本 IR / LLVM）输出逐字节一致。
// 运行：tests/pde_backends.sh
//
// 覆盖：pde_heat_explicit / pde_heat_cn / pde_heat_2d / pde_heat_2d_adi /
//       pde_wave_leapfrog / pde_advect_upwind / pde_advect_lw /
//       pde_burgers_inviscid / pde_burgers_viscous / pde_poisson_jacobi /
//       pde_poisson_sor / pde_sor_optimal_omega / pde_poisson_residual /
//       pde_robin_1d
// 各用例均带解析解对照（热方程 sin(πx)e^{-π²t}、波动 sin(πx)cos(πt)、
// 泊松 sin(πx)sin(πy)、Burgers 稳态行波 −tanh(5x)、Riemann 激波速度 0.5、
// Robin 边值 1+x² 与 sin(2x)+cos(x) 的二阶收敛、SOR 最优 ω 与残差量级），
// 打印 [数值, 解析, 误差] 三行便于肉眼核验。
// 注：有限差分法输出为收敛到的浮点值；三后端因执行同一份 AST（浮点运算顺序
// 由 lume 显式控制）必然逐字节一致，与具体精度无关。

import "../lib/pde.lume" as pde;

let PI = 3.141592653589793;

// ── 热方程：u0 = sin(πx)，零边界，α=1 → 解析 u = sin(πx)·e^{-π²t}
let nx = 21;
let xs: float[] = pde.pde_linspace(0.0, 1.0, nx);
let u0: float[] = [];
for (let i = 0; i < nx; i = i + 1) { u0 = push(u0, sin(PI * xs[i])); }
let dte = 0.0005;
let nte = 200;                       // t = 0.1
let te = dte * nte;
let xmid = 0.5;
let exact_heat = sin(PI * xmid) * exp(-PI * PI * te);

// 显式 FTCS（r = 1·0.0005/0.05² = 0.2，稳定）
let ue = pde.pde_heat_explicit(u0, 0.0, 1.0, 1.0, dte, nte, 0.0, 0.0);
print(ue[10]);                       // x=0.5
print(exact_heat);
print(ue[10] - exact_heat);          // 显式离散误差（应很小）

// 隐式 Crank–Nicolson（大步长 r=4，显式会发散，CN 仍稳定）
let uc = pde.pde_heat_cn(u0, 0.0, 1.0, 1.0, 0.01, 10, 0.0, 0.0);   // t = 0.1
print(uc[10]);
print(exact_heat);
print(uc[10] - exact_heat);          // CN 误差（更小）

// ── 波动方程：u0 = sin(πx)，零初速零边界，c=1 → u = sin(πx)·cos(πt)
let dtw = 0.02;
let ntw = 25;                        // t = 0.5，cos(π·0.5) = 0
let tw = dtw * ntw;
let uw = pde.pde_wave_leapfrog(u0, 0.0, 1.0, 1.0, dtw, ntw, 0.0, 0.0);
print(uw[10]);
print(sin(PI * xmid) * cos(PI * tw));
print(uw[10] - sin(PI * xmid) * cos(PI * tw));

// ── 泊松方程：u = sin(πx)sin(πy)，∇²u = -2π²u → f = -2π² sin(πx)sin(πy)
let np = 9;
let hp = 1.0 / (np - 1.0);
let f: float[][] = [];
for (let i = 0; i < np; i = i + 1) {
  let row: float[] = [];
  for (let j = 0; j < np; j = j + 1) {
    let xx = hp * i;
    let yy = hp * j;
    row = push(row, -2.0 * PI * PI * sin(PI * xx) * sin(PI * yy));
  }
  f = push(f, row);
}
let up = pde.pde_poisson_jacobi(f, hp, 400);
let ci = 4;                          // 中心（9×9 的索引 4）
let exact_poisson = sin(PI * hp * ci) * sin(PI * hp * ci);
print(up[ci][ci]);
print(exact_poisson);
print(up[ci][ci] - exact_poisson);

// ── 二维热方程：2D FTCS，Dirichlet / Neumann 边界 ──
let n2 = 11;
let x2: float[] = pde.pde_linspace(0.0, 1.0, n2);
let dt2 = 0.0005;
let nt2 = 200;                        // t = 0.1
let t2 = dt2 * nt2;

// Neumann 零通量：u0 = cos(πx)cos(πy)（自动满足 ∂u/∂n=0）
// 解析 u = cos(πx)cos(πy)·e^{-2π²αt}。检查点 (0.2, 0.2)
let u0n: float[][] = [];
for (let i = 0; i < n2; i = i + 1) {
  let row: float[] = [];
  for (let j = 0; j < n2; j = j + 1) {
    row = push(row, cos(PI * x2[i]) * cos(PI * x2[j]));
  }
  u0n = push(u0n, row);
}
let un = pde.pde_heat_2d(u0n, 0.1, 0.1, 1.0, dt2, nt2, true);
let exact_n = cos(PI * 0.2) * cos(PI * 0.2) * exp(-2.0 * PI * PI * t2);
print(un[2][2]);
print(exact_n);
print(un[2][2] - exact_n);

// Dirichlet 零边界：u0 = sin(πx)sin(πy)（边界自动=0）
// 解析 u = sin(πx)sin(πy)·e^{-2π²αt}。检查点中心 (0.5, 0.5)
let u0d: float[][] = [];
for (let i = 0; i < n2; i = i + 1) {
  let row: float[] = [];
  for (let j = 0; j < n2; j = j + 1) {
    row = push(row, sin(PI * x2[i]) * sin(PI * x2[j]));
  }
  u0d = push(u0d, row);
}
let ud = pde.pde_heat_2d(u0d, 0.1, 0.1, 1.0, dt2, nt2, false);
let exact_d = sin(PI * 0.5) * sin(PI * 0.5) * exp(-2.0 * PI * PI * t2);
print(ud[5][5]);
print(exact_d);
print(ud[5][5] - exact_d);

// ── 二维热方程 ADI 隐式：与显式 FTCS 的大步长对照 ──
// 显式 FTCS 稳定域 r_x+r_y ≤ 0.5（r_x = αdt/dx²）。dt=0.01 时 r_x+r_y=2，
// 远超稳定域：对本例光滑初值 sin(πx)sin(πy) 放大因子仍 |g|≈0.804<1，不会
// 数值爆炸，而是**严重失真**（衰减过快）；高频模态才会真正发散。
let ubig = pde.pde_heat_2d(u0d, 0.1, 0.1, 1.0, 0.01, 10, false);      // 显式，t=0.1
print(ubig[5][5]);                       // ≈0.113，相对解析偏差 ≈ −18.5%

// ADI 无条件稳定，同参数仍收敛。
// 注：ADI 与解析的误差 ~2e-3 主要来自 11×11 网格的二阶空间离散（使衰减偏慢、
//     数值偏大），非时间项。ADI 二阶时间精度、显式 FTCS 一阶，二者不宜直接
//     相减判等；此处统一以解析解 exact_d 作基准。
let uadi = pde.pde_heat_2d_adi(u0d, 0.1, 0.1, 1.0, 0.01, 10, 0.0);    // t=0.1
print(uadi[5][5]);                       // ≈0.141
print(exact_d);                          // ≈0.139
print(uadi[5][5] - exact_d);             // ≈2e-3

// 同一物理时刻 t=0.1 把 dt 缩小 5 倍（nt ×5）再算一次：两者之差仅反映
// 时间离散误差；差值很小即说明大步长 ADI 未引入明显时间误差。
let uadi2 = pde.pde_heat_2d_adi(u0d, 0.1, 0.1, 1.0, 0.002, 50, 0.0);  // t=0.1
print(uadi2[5][5] - uadi[5][5]);        // ≈2.1e-4

// ── 一维线性对流 u_t + c·u_x = 0：周期边界 + 格式耗散对比 ──
// 周期网格 x_i = i/n（不含右端点），u0 = sin(2πx)，c=1。
// C = c·dt/dx = 0.5，t = 1 恰好平移一个整周期 → 解析解 = 初值（振幅 1）。
let na = 40;
let dxa = 1.0 / (na * 1.0);
let dta = 0.5 * dxa;                    // C = 0.5
let nta = 80;                           // t = dta·nta = 1.0
// 循环变量统一带 adv_ 前缀：lume 顶层脚本的 for-init 不得遮蔽内置名，
// 例如 ic 是内置的「信息系数」函数（src/typecheck.c 内置表），用它作
// for-init 变量会报 "shadows an outer local"（函数体内有 fn_root 才安全）。
let ua: float[] = [];
for (let adv_i0 = 0; adv_i0 < na; adv_i0 = adv_i0 + 1) {
  ua = push(ua, sin(2.0 * PI * (adv_i0 / (na * 1.0))));
}
let sum0 = 0.0;
for (let adv_i1 = 0; adv_i1 < na; adv_i1 = adv_i1 + 1) { sum0 = sum0 + ua[adv_i1]; }
let uu = pde.pde_advect_upwind(ua, dxa, 1.0, dta, nta, true, 0.0);
let ul = pde.pde_advect_lw(ua, dxa, 1.0, dta, nta, true, 0.0);

// 周期环绕正确性：两格式均为守恒型，Σu 应严格不变（无边界泄漏）
let sumu = 0.0;
for (let adv_i2 = 0; adv_i2 < na; adv_i2 = adv_i2 + 1) { sumu = sumu + uu[adv_i2]; }
let suml = 0.0;
for (let adv_i3 = 0; adv_i3 < na; adv_i3 = adv_i3 + 1) { suml = suml + ul[adv_i3]; }
print(sumu - sum0);                     // ≈0（迎风）
print(suml - sum0);                     // ≈0（Lax–Wendroff）

// 解析解：平移整周期后 u(x,1) = u0(x)。逐点误差 ≈0 说明周期边界+相位正确
print(ul[10] - ua[10]);                 // LW：≈0（二阶，相位误差小）
print(uu[10] - ua[10]);                 // 迎风：明显非 0（耗散+相位误差）

// 振幅 max|u|：数值解仍近似正弦，振幅反映耗散且不受相位误差影响
let amp0 = 0.0;
for (let adv_i4 = 0; adv_i4 < na; adv_i4 = adv_i4 + 1) { if (abs(ua[adv_i4]) > amp0) { amp0 = abs(ua[adv_i4]); } }
let ampu = 0.0;
for (let adv_i5 = 0; adv_i5 < na; adv_i5 = adv_i5 + 1) { if (abs(uu[adv_i5]) > ampu) { ampu = abs(uu[adv_i5]); } }
let ampl = 0.0;
for (let adv_i6 = 0; adv_i6 < na; adv_i6 = adv_i6 + 1) { if (abs(ul[adv_i6]) > ampl) { ampl = abs(ul[adv_i6]); } }
print(amp0);                            // = 1（解析振幅）
print(ampu);                            // 迎风：明显 < 1（一阶耗散）
print(ampl);                            // LW：≈1（二阶，振幅保持好）
print(amp0 - ampu);                     // 迎风耗散量
print(amp0 - ampl);                     // LW 耗散量（应远小于上一行）

// Dirichlet 非周期分支冒烟：bc=0，验证边界分支不越界、结果有限
let udd = pde.pde_advect_lw(ua, dxa, 1.0, dta, nta, false, 0.0);
print(udd[na - 1]);

// ── 非线性 Burgers：粘性稳态行波（精确解析解）──────────────────
// u_t + u·u_x = ν·u_xx 有稳态行波 u(x) = −a·tanh(a·x/(2ν)) + c。
// 取 a=1、c=0、ν=0.1 → u(x) = −tanh(5x)，代入得 u·u_x = ν·u_xx，
// 即 u_t = 0：该剖面是**精确稳态解**。域 [−1,1]、n=41 → dx=0.05，
// 网格 Peclet 数 |u|dx/ν = 0.5 < 2（中心差分不振荡）。
// 以解析解为初值演化到 t=0.2，数值解应保持不变（离散稳态误差 O(dx²)）。
let nb = 41;
let dxb = 2.0 / (nb - 1.0);
let bclb = tanh(5.0);
let bcrb = -bclb;
let ub0: float[] = [];
for (let bg_i0 = 0; bg_i0 < nb; bg_i0 = bg_i0 + 1) {
  let xb = -1.0 + dxb * bg_i0;
  ub0 = push(ub0, -tanh(5.0 * xb));
}
let ubv = pde.pde_burgers_viscous(ub0, dxb, 0.1, 0.002, 100, false, bclb, bcrb);
print(ubv[10]);                          // x = −0.5 处的数值解
print(tanh(2.5));                        // 解析：−tanh(5·(−0.5)) = tanh(2.5)
print(ubv[10] - tanh(2.5));              // 稳态误差（应 ≈1e-4）
print(ubv[20]);                          // x = 0，解析 0（反对称）

// ── 非线性 Burgers：无粘 Riemann 激波（解析激波速度）───────────
// u_L=1、u_R=0，跳跃位于网格界面 x=0.495（i=49/50 之间）。
// Rankine–Hugoniot: s = (f(1)−f(0))/(1−0) = 0.5，故 t=0.1 时
// u=0.5 的插值位置应为 0.495 + 0.5·0.1 = 0.545。
// 常值入/出流 bcl=1、bcr=0 → 净通量 0.5，∫u dx 增量 = 0.5·t = 0.05。
let nr = 100;
let dxr = 1.0 / (nr * 1.0);
let dtr = 0.004;                         // max|u|·dt/dx = 0.4（稳定）
let ur0: float[] = [];
for (let bg_i1 = 0; bg_i1 < nr; bg_i1 = bg_i1 + 1) {
  let vv: float = 0.0;
  if (bg_i1 < 50) { vv = 1.0; }
  ur0 = push(ur0, vv);
}
let ubr = pde.pde_burgers_inviscid(ur0, dxr, dtr, 25, false, 1.0, 0.0);

// 以 u=0.5 线性插值定位激波：Rusanov 把跳跃抹宽数格，中点仍精确
let xshock = 0.0;
for (let bg_i2 = 0; bg_i2 < nr - 1; bg_i2 = bg_i2 + 1) {
  if (ubr[bg_i2] >= 0.5 && ubr[bg_i2 + 1] < 0.5) {
    xshock = (bg_i2 + (ubr[bg_i2] - 0.5) / (ubr[bg_i2] - ubr[bg_i2 + 1])) * dxr;
  }
}
print(xshock);
print(0.545);
print(xshock - 0.545);                   // 激波位置误差

// 质量平衡：守恒型格式下 Δ∫u = (f(bcl) − f(bcr))·t
let sr0 = 0.0;
let srt = 0.0;
for (let bg_i3 = 0; bg_i3 < nr; bg_i3 = bg_i3 + 1) {
  sr0 = sr0 + ur0[bg_i3];
  srt = srt + ubr[bg_i3];
}
print(dxr * (srt - sr0));
print(0.05);
print(dxr * (srt - sr0) - 0.05);

// 一阶单调格式应满足最大值原理：解不越出 [u_R, u_L]
let bg_umax = 0.0;
let bg_umin = 1.0;
for (let bg_i4 = 0; bg_i4 < nr; bg_i4 = bg_i4 + 1) {
  if (ubr[bg_i4] > bg_umax) { bg_umax = ubr[bg_i4]; }
  if (ubr[bg_i4] < bg_umin) { bg_umin = ubr[bg_i4]; }
}
print(bg_umax);                          // ≈1
print(bg_umin);                          // ≈0（无负过冲）

// 周期分支：守恒型格式 + 周期环绕 → Σu 严格不变（无边界通量泄漏）
let up0: float[] = [];
for (let bg_i5 = 0; bg_i5 < na; bg_i5 = bg_i5 + 1) {
  up0 = push(up0, sin(2.0 * PI * (bg_i5 / (na * 1.0))));
}
let ubp = pde.pde_burgers_inviscid(up0, dxa, 0.2 * dxa, 20, true, 0.0, 0.0);
let sbp0 = 0.0;
let sbpt = 0.0;
for (let bg_i6 = 0; bg_i6 < na; bg_i6 = bg_i6 + 1) {
  sbp0 = sbp0 + up0[bg_i6];
  sbpt = sbpt + ubp[bg_i6];
}
print(sbpt - sbp0);                      // ≈0

// 粘性求解器的周期分支：常数态 u≡0.5 是精确稳态（对流、扩散项均为 0），
// 且不会触发首尾点 Dirichlet 强加分支。
let uc0: float[] = [];
for (let bg_i7 = 0; bg_i7 < na; bg_i7 = bg_i7 + 1) { uc0 = push(uc0, 0.5); }
let ucv = pde.pde_burgers_viscous(uc0, dxa, 0.1, 0.001, 10, true, 0.0, 0.0);
print(ucv[17] - 0.5);                   // ≈0

// ── Robin / 混合边界：1D 两点边值 −u'' = f，左右独立 u ∓ β·u' = g ────
// 精确解 u = 1 + x²，f = −2；u(0)=1,u'(0)=0，u(1)=2,u'(1)=2。
// 取 β_L=0.25、β_R=0.5 → g_L=1、g_R=2+0.5·2=3。
// ghost-cell 二阶离散对二次多项式精确，误差应达机器精度。
let rb_n = 21;
let rb_h = 1.0 / (rb_n - 1.0);
let rb_x: float[] = pde.pde_linspace(0.0, 1.0, rb_n);
let rb_f: float[] = [];
for (let rb_i0 = 0; rb_i0 < rb_n; rb_i0 = rb_i0 + 1) {
  rb_f = push(rb_f, -2.0);
}
let rb_u = pde.pde_robin_1d(rb_f, rb_h, 0.25, 0.5, 1.0, 3.0);
let rb_emax = 0.0;
for (let rb_i1 = 0; rb_i1 < rb_n; rb_i1 = rb_i1 + 1) {
  let rb_d: float = rb_u[rb_i1] - (1.0 + rb_x[rb_i1] * rb_x[rb_i1]);
  if (rb_d < 0.0) { rb_d = -rb_d; }
  if (rb_d > rb_emax) { rb_emax = rb_d; }
}
print(rb_u[10]);                        // 1.25
print(1.25);
print(rb_u[10] - 1.25);                 // ≈0
print(rb_emax);                         // ≈6.4e-15，二次解机器精度精确

// β_L=β_R=0 退化为 Dirichlet：g_L=u(0)=1、g_R=u(1)=2
let rb_ud = pde.pde_robin_1d(rb_f, rb_h, 0.0, 0.0, 1.0, 2.0);
let rb_edmax = 0.0;
for (let rb_i2 = 0; rb_i2 < rb_n; rb_i2 = rb_i2 + 1) {
  let rb_d: float = rb_ud[rb_i2] - (1.0 + rb_x[rb_i2] * rb_x[rb_i2]);
  if (rb_d < 0.0) { rb_d = -rb_d; }
  if (rb_d > rb_edmax) { rb_edmax = rb_d; }
}
print(rb_edmax);                        // ≈4.4e-16

// 左右分支独立：仅右端 Robin（β_L=0 左 Dirichlet，β_R=0.5 右 Robin）
let rb_um = pde.pde_robin_1d(rb_f, rb_h, 0.0, 0.5, 1.0, 3.0);
let rb_emmax = 0.0;
for (let rb_i3 = 0; rb_i3 < rb_n; rb_i3 = rb_i3 + 1) {
  let rb_d: float = rb_um[rb_i3] - (1.0 + rb_x[rb_i3] * rb_x[rb_i3]);
  if (rb_d < 0.0) { rb_d = -rb_d; }
  if (rb_d > rb_emmax) { rb_emmax = rb_d; }
}
print(rb_um[rb_n - 1]);                 // 右端是 Robin 解，值应为 u(1)=2
print(2.0);
print(rb_um[rb_n - 1] - 2.0);           // ≈0（而非被强加成 g_R=3）
print(rb_emmax);                        // ≈0

// ── 二阶收敛：非多项式解 u = sin(2x)+cos(x)，f = 4sin(2x)+cos(x)
// u(0)=1,u'(0)=2 → β_L=0.25 时 g_L = 1−0.25·2 = 0.5
// u(1)=sin2+cos1, u'(1)=2cos2−sin1 → g_R = u(1)+0.5u'(1)
// h 减半误差应降 4 倍，验证 ghost-cell Robin 离散确为二阶、非多项式巧合。
let rb_gl = 1.0 - 0.25 * 2.0;
let rb_gr = sin(2.0) + cos(1.0) + 0.5 * (2.0 * cos(2.0) - sin(1.0));

let rb_n21 = 21;
let rb_h21 = 1.0 / (rb_n21 - 1.0);
let rb_x21: float[] = pde.pde_linspace(0.0, 1.0, rb_n21);
let rb_f21: float[] = [];
for (let rb_i4 = 0; rb_i4 < rb_n21; rb_i4 = rb_i4 + 1) {
  rb_f21 = push(rb_f21, 4.0 * sin(2.0 * rb_x21[rb_i4]) + cos(rb_x21[rb_i4]));
}
let rb_u21 = pde.pde_robin_1d(rb_f21, rb_h21, 0.25, 0.5, rb_gl, rb_gr);
let rb_e21 = 0.0;
for (let rb_i5 = 0; rb_i5 < rb_n21; rb_i5 = rb_i5 + 1) {
  let rb_d: float = rb_u21[rb_i5] - (sin(2.0 * rb_x21[rb_i5]) + cos(rb_x21[rb_i5]));
  if (rb_d < 0.0) { rb_d = -rb_d; }
  if (rb_d > rb_e21) { rb_e21 = rb_d; }
}
print(rb_e21);

let rb_n41 = 41;
let rb_h41 = 1.0 / (rb_n41 - 1.0);
let rb_x41: float[] = pde.pde_linspace(0.0, 1.0, rb_n41);
let rb_f41: float[] = [];
for (let rb_i6 = 0; rb_i6 < rb_n41; rb_i6 = rb_i6 + 1) {
  rb_f41 = push(rb_f41, 4.0 * sin(2.0 * rb_x41[rb_i6]) + cos(rb_x41[rb_i6]));
}
let rb_u41 = pde.pde_robin_1d(rb_f41, rb_h41, 0.25, 0.5, rb_gl, rb_gr);
let rb_e41 = 0.0;
for (let rb_i7 = 0; rb_i7 < rb_n41; rb_i7 = rb_i7 + 1) {
  let rb_d: float = rb_u41[rb_i7] - (sin(2.0 * rb_x41[rb_i7]) + cos(rb_x41[rb_i7]));
  if (rb_d < 0.0) { rb_d = -rb_d; }
  if (rb_d > rb_e41) { rb_e41 = rb_d; }
}
print(rb_e41);
print(rb_e21 / rb_e41);                 // ≈4

let rb_n81 = 81;
let rb_h81 = 1.0 / (rb_n81 - 1.0);
let rb_x81: float[] = pde.pde_linspace(0.0, 1.0, rb_n81);
let rb_f81: float[] = [];
for (let rb_i8 = 0; rb_i8 < rb_n81; rb_i8 = rb_i8 + 1) {
  rb_f81 = push(rb_f81, 4.0 * sin(2.0 * rb_x81[rb_i8]) + cos(rb_x81[rb_i8]));
}
let rb_u81 = pde.pde_robin_1d(rb_f81, rb_h81, 0.25, 0.5, rb_gl, rb_gr);
let rb_e81 = 0.0;
for (let rb_i9 = 0; rb_i9 < rb_n81; rb_i9 = rb_i9 + 1) {
  let rb_d: float = rb_u81[rb_i9] - (sin(2.0 * rb_x81[rb_i9]) + cos(rb_x81[rb_i9]));
  if (rb_d < 0.0) { rb_d = -rb_d; }
  if (rb_d > rb_e81) { rb_e81 = rb_d; }
}
print(rb_e81);
print(rb_e41 / rb_e81);                 // ≈4

// ── 二维泊松 SOR 超松弛：与 400 次 Jacobi 同一离散解，迭代量差一个量级 ──
// 沿用上面 np=9 / hp / f（−2π²sin(πx)sin(πy)，零 Dirichlet 边界）。
// 理论：ρ_J = cos(π/8)=0.92388 → 400 次衰减 ≈1.7e-14；
//       ω_opt = 2/(1+sin(π/8))=1.44646，ρ_SOR = ω_opt−1≈0.44646，
//       渐近估计约 40 次；实测 50 次降到舍入下限（前渐近阶段略慢）。
let sor_w = pde.pde_sor_optimal_omega(np);
let sor_we = 2.0 / (1.0 + sin(PI / (np - 1.0)));
print(sor_w);
print(sor_we);
print(sor_w - sor_we);                  // ≈0

// 50 次 SOR(ω_opt) 应收敛到与 400 次 Jacobi 完全相同的离散解
let sor_u50 = pde.pde_poisson_sor(f, hp, 50, sor_w);
print(sor_u50[ci][ci]);
print(up[ci][ci]);
print(sor_u50[ci][ci] - up[ci][ci]);   // ≈1.8e-14（同一离散方程的唯一解）
print(sor_u50[ci][ci] - exact_poisson);// ≈0.01295，与 Jacobi 相同的 O(h²) 空间误差

// 残差诊断：同样 50 次迭代，SOR 比 Jacobi 低约 13 个数量级
let sor_uj = pde.pde_poisson_jacobi(f, hp, 50);
let sor_rj: float = pde.pde_poisson_residual(sor_uj, f, hp);
let sor_rs: float = pde.pde_poisson_residual(sor_u50, f, hp);
let sor_rj400: float = pde.pde_poisson_residual(up, f, hp);
print(sor_rj);
print(sor_rs);
print(sor_rs / sor_rj);                 // ≪1
print(sor_rj400);                       // 400 次 Jacobi 才降到舍入下限
// 50 次 SOR 残差 6.75e-14 已优于 400 次 Jacobi 的 3.62e-13：
// 同等精度迭代量差 8 倍（差距随网格加密按 O(n) vs O(n²) 继续拉大）

// ω 参数生效且最优点最优：ω=1 退化为 Gauss–Seidel（ρ=ρ_J²≈0.854，
// 比 Jacobi 快）；ω=0.5 欠松弛反而更慢；ω_opt 最快。
let sor_ug = pde.pde_poisson_sor(f, hp, 50, 1.0);
let sor_uu = pde.pde_poisson_sor(f, hp, 50, 0.5);
let sor_rg: float = pde.pde_poisson_residual(sor_ug, f, hp);
let sor_ru: float = pde.pde_poisson_residual(sor_uu, f, hp);
print(sor_rg);
print(sor_ru);
print(sor_rg / sor_rj);                 // <1，GS 快于 Jacobi
print(sor_rs / sor_rg);                 // ≪1，最优 SOR 快于 GS
print(sor_ru / sor_rj);                 // >1，欠松弛慢于 Jacobi

// 残差随迭代单调下降：10 / 25 / 50 次，50 次才降到浮点舍入下限
let sor_u10 = pde.pde_poisson_sor(f, hp, 10, sor_w);
let sor_u25 = pde.pde_poisson_sor(f, hp, 25, sor_w);
let sor_r10: float = pde.pde_poisson_residual(sor_u10, f, hp);
let sor_r25: float = pde.pde_poisson_residual(sor_u25, f, hp);
print(sor_r10);
print(sor_r25);
print(sor_rs);

// 网格加密到 17×17：ρ_J=cos(π/16)=0.9808 更接近 1（Jacobi 更慢），
// ρ_SOR=ω_opt(17)−1≈0.6735 仍快速收敛，展示 O(n) vs O(n²) 的差距。
let sq_n = 17;
let sq_h = 1.0 / (sq_n - 1.0);
let sq_f: float[][] = [];
for (let sor_i0 = 0; sor_i0 < sq_n; sor_i0 = sor_i0 + 1) {
  let sq_row: float[] = [];
  for (let sor_i1 = 0; sor_i1 < sq_n; sor_i1 = sor_i1 + 1) {
    sq_row = push(sq_row, -2.0 * PI * PI * sin(PI * sq_h * sor_i0)
                          * sin(PI * sq_h * sor_i1));
  }
  sq_f = push(sq_f, sq_row);
}
let sq_w = pde.pde_sor_optimal_omega(sq_n);
let sq_uj = pde.pde_poisson_jacobi(sq_f, sq_h, 100);
let sq_us = pde.pde_poisson_sor(sq_f, sq_h, 100, sq_w);
let sq_rj: float = pde.pde_poisson_residual(sq_uj, sq_f, sq_h);
let sq_rs: float = pde.pde_poisson_residual(sq_us, sq_f, sq_h);
print(sq_w);
print(sq_rj);
print(sq_rs);
print(sq_rs / sq_rj);                   // ≪1；Jacobi 100 次仍有 O(1) 残差，
// 而 SOR 已到机器精度，网格加密后 Jacobi 的 O(n²) 劣势进一步暴露
