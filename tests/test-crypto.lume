// lume —— sha256 / hmac_sha256 内建单测（tests/test-crypto.lume）
//
// 纯 C 实现（vendored src/compat/sha256/，public domain），全平台字节级一致，
// 不涉 crypt(3) 的平台差异。已知向量来自 FIPS 180-4 / RFC 4231 及
// python hashlib 参考实现；长 key（>64B）走 key 先 hash 分支。
// 输出 PASS/FAIL，make crypto-test grep FAIL 判定。运行：make crypto-test。

func check(name, cond) {
  if (cond) {
    print("PASS " + name);
  } else {
    print("FAIL " + name);
  }
}

// ---- sha256 已知向量 ----
check("sha256 空串",
      sha256("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
check("sha256 abc",
      sha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
check("sha256 56字节(跨块)",
      sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
        == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
check("sha256 quick brown fox",
      sha256("The quick brown fox jumps over the lazy dog")
        == "d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592");

// 多块流式路径：1000 字符（>15 个 64B 块）
let big = "";
let bi = 0;
while (bi < 50) {
  big = big + "aaaaaaaaaaaaaaaaaaaa";
  bi = bi + 1;
}
check("sha256 1000a 多块流式",
      len(big) == 1000 && sha256(big) == "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3");

// ---- hmac_sha256 已知向量 ----
check("hmac key/fox",
      hmac_sha256("key", "The quick brown fox jumps over the lazy dog")
        == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8");
check("hmac Jefe (RFC 4231 case 2)",
      hmac_sha256("Jefe", "what do ya want for nothing?")
        == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843");
check("hmac 空 message",
      hmac_sha256("key", "")
        == "5d5d139563c95b5967b9bd9a8c9b233a9dedb45072794cd232dc1b74832607d0");
check("hmac 空 key",
      hmac_sha256("", "msg")
        == "5f576a8d68fe4fb7eb823227246353c0870c3b0e878997341db1226b4bd88d61");

// 长 key（100B > 64B 块长 → key 先 SHA-256 再 pad 的分支）
let longkey = "";
let li = 0;
while (li < 100) {
  longkey = longkey + "k";
  li = li + 1;
}
check("hmac 长key(>64B)",
      hmac_sha256(longkey, "lume-nsgm payment canonical string v1")
        == "d8b4d06bec97d498336fc24ae111995847826f7e8f5ce58181ef41b66612f573");

// ---- 输出形状 ----
check("sha256 输出 64 位小写 hex",
      len(sha256("x")) == 64 && contains("0123456789abcdef", substr(sha256("x"), 0, 1)));
check("hmac 输出 64 位小写 hex",
      len(hmac_sha256("k", "m")) == 64);
check("确定性：同输入同输出",
      sha256("determinism") == sha256("determinism")
        && hmac_sha256("k", "determinism") == hmac_sha256("k", "determinism"));

// ---- 负例：非 string / 参数个数 ----
let e1 = try(() => sha256(42));
check("sha256 非字符串参数报错", get(e1, "err", null) != null);
let e2 = try(() => sha256());
check("sha256 零参数报错", get(e2, "err", null) != null);
let e3 = try(() => hmac_sha256("onlykey"));
check("hmac 单参数报错", get(e3, "err", null) != null);
let e4 = try(() => hmac_sha256(1, "m"));
check("hmac 非字符串参数报错", get(e4, "err", null) != null);

// ---- base64 (2026-10-16, RFC 4648) ----
check("base64 encode 空串", base64_encode("") == "");
check("base64 encode f", base64_encode("f") == "Zg==");
check("base64 encode fo", base64_encode("fo") == "Zm8=");
check("base64 encode fox", base64_encode("fox") == "Zm94");
check("base64 encode man", base64_encode("man") == "bWFu");
check("base64 encode 二进制安全(含NUL)",
      base64_encode("a\0b") == "YQBi");
check("base64 decode fox", base64_decode("Zm94") == "fox");
check("base64 decode 二进制安全(含NUL)",
      base64_decode("YQBi") == "a\0b");
check("base64 roundtrip id:secret",
      base64_decode(base64_encode("id:secret")) == "id:secret");
check("base64 roundtrip 中文(多字节)",
      base64_decode(base64_encode("支付测试¥")) == "支付测试¥");
check("base64 roundtrip 长串",
      base64_decode(base64_encode("The quick brown fox jumps over the lazy dog!!"))
        == "The quick brown fox jumps over the lazy dog!!");
let be1 = try(() => base64_decode("!!!!"));
check("base64 decode 非法字符报错", get(be1, "err", null) != null);
let be2 = try(() => base64_decode("Zm9"));
check("base64 decode 长度非4倍数报错", get(be2, "err", null) != null);
let be3 = try(() => base64_decode("Z=m9"));
check("base64 decode 填充错位报错", get(be3, "err", null) != null);

