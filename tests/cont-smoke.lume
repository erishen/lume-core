// mixed-sampler smoke (2026-10-27): binomial / lognormal / gumbel /
// rayleigh / triangular on the deterministic PCG32 stream (seed 42),
// values verified against the independent stateful Python reference.
seed(42);
print(rand_binomial(10, 0.5));
print(rand_lognormal(0.0, 1.0));
print(rand_gumbel(0.0, 1.0));
print(rand_rayleigh(1.0));
print(rand_triangular(0.0, 1.0));
seed(42);
print(rand_binomial(3, 0.2));
print(rand_lognormal(1.0, 0.5));
