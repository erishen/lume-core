// inverse-transform sampler smoke (2026-10-26): geometric / weibull /
// logistic / pareto / laplace on the deterministic PCG32 stream (seed 42),
// values verified against the independent stateful Python reference.
seed(42);
print(rand_geometric(0.5));
print(rand_weibull(2.0, 1.0));
print(rand_logistic(0.0, 1.0));
print(rand_pareto(1.0, 2.0));
print(rand_laplace(0.0, 1.0));
seed(42);
print(rand_geometric(0.1));
print(rand_weibull(0.5, 3.0));
