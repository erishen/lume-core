# lume-core — build artifacts (regenerate with `make`)
/build/
/build-asan/
# 发布构建 (make pack 重编这套, 见 Makefile 的 PACK_CFLAGS)
/build-pack/
# fuzz-ci 的插桩对象 (SanCov+ASan, 带编译机绝对路径 DWARF)。构建目录刻意逐条
# 列举而非 build*/ 通配 (宽通配曾误伤 build_core.bat 一类文件), 所以 Makefile
# 每新增一个 build 目录, 这里必须同步登记 — build-fuzz/ 就是 fuzz-ci 落地时
# 漏登记的一个: 干净机器跑完 CI 腿, 未跟踪的 .o 群会出现在 git status 里,
# 一次 `git add .` 就把本机路径带进公开仓 (*.o 兜底, 但兜底不该指望)。
/build-fuzz/
/bin/
/out/
# make pack 的产物 (lume-core-<os>-<arch>.tar.gz)
/dist/
*.o
*.a

# C test binaries + their macOS debug symbols (+ .exe on Windows/mingw)
/tests/smoke-bin
/tests/smoke-bin.exe
/tests/smoke-bin-asan
/tests/smoke-bin-asan.exe
*.dSYM/

# 开发期手抄的整份二进制副本 (make 产物, 带 -g ⇒ DWARF 里记着编译时的
# /Users/<name>/... 绝对路径)。2026-10-05 之前这两个文件被 commit 进来过,
# 是仓库里唯二的构建机路径泄漏; 现在移到 ~/.lume-core-backups/ 并在这里挡住,
# 免得 `git add -A` 再把它们捞回来。scripts/check-tree-privacy.sh 是第二道闸。
/backups/

# 本仓根目录下的 agent 项目记忆目录（跨会话 continuity 笔记，非源码）。
# 当前未跟踪；挡住它以免将来 `git add -A` 把它扫进这个 PUBLIC 仓。
# 只挡提交、不删目录（符合勿删 .workbuddy 的纪律）。
/.workbuddy/

# local runtime state (the host tree owns the server; this tree keeps none,
# but .data/ is the shared convention if a script happens to create it)
/.data/

# Windows local build via build_core.bat: machine-local config and the
# compiler log it writes next to the tree
/.env
/build_err.txt

# `tests/smoke.c` does `mkdir(".data")` to reset the mcps() catalog and then
# unlinks the catalog file, leaving the directory behind — so running the suite
# from tests/ (or anywhere but the checkout root) dirties the work tree with a
# `?? tests/.data/`. Anchored on purpose: it should catch the test's own
# scratch directory and nothing a human puts in a .data/ on purpose.
tests/.data/

# generated by `make vscode-cpp`: the LLVM include dir is version-stamped
# (Cellar/23.1.2), so it belongs to this machine, not to the repo
/.vscode/c_cpp_properties.json

# compile-text/compile-llvm output when the shell cwd is src/ (a cwd-dependent
# sibling of the /out/ entry above); these are build artifacts, not sources
src/out/

# Local editor / agent tooling config — keep local-only, never commit
.vscode/
.claude/
.trae/
.agents/
.codex/
.cursor/
