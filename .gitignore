# lume-llvm — build artifacts (regenerate with `make`)
/build/
/build-asan/
/bin/
/out/
*.o
*.a

# C test binaries + their macOS debug symbols
/tests/smoke-bin
/tests/smoke-bin-asan
*.dSYM/

# local runtime state (the host tree owns the server; this tree keeps none,
